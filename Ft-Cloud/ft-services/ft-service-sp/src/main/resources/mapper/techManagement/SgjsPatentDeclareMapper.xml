    </select>
    <select id="getSgjsPatentDeclare" resultMap="SgjsPatentDeclareResultMap">
        <include refid="selectSgjsPatentDeclareVo"/>
        <where>
            del_flag = "0"
            <if test="patentName != null  and patentName != ''">and `patent_name` = #{patentName}</if>
            <if test="patentNumber != null  and patentNumber != ''">and `patent_number` = #{patentNumber}</if>
            <if test="currentState != null  and currentState != ''">and `current_state` = #{currentState}</if>
        </where>
        order by create_time desc
    </select>

    <select id="getSgjsPatentDeclareList" resultMap="SgjsPatentDeclareResultMap">
        <include refid="selectSgjsPatentDeclareVo"/>
        <where>
            del_flag = "0"
            <if test="patentName != null  and patentName != ''">and `patent_name` like concat('%' , #{patentName} , '%')</if>
            <if test="patentNumber != null  and patentNumber != ''">and `patent_number` like concat('%' , #{patentNumber} , '%')</if>
            <if test="currentState != null  and currentState != ''">and `current_state` = #{currentState}</if>
        </where>
        order by create_time desc
    </select>
    <select id="getCountByPatentNumberExpectId" resultType="java.lang.Integer">
        select count(1) from sgjs_patent_declare where patent_number = #{patentNumber} and id != #{id}
    </select>
    <select id="getListByIds" resultMap="SgjsPatentDeclareResultMap">
        <include refid="selectSgjsPatentDeclareVo"/>
        <where>
            del_flag = "0"
            <if test="ids != null and ids.size() > 0">
                and `id` in
                <foreach item="id" collection="ids" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
        order by create_time desc
    </select>

