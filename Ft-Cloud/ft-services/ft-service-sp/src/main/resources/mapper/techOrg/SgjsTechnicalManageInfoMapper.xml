        <where>
            `tech_id` in
            <foreach item="id" collection="techIdList" open="(" separator="," close=")">
                #{id}
            </foreach>
        </where>
    </update>

    <update id="delectAll" parameterType="com.hhwy.sp.techOrg.domain.SgjsTechnicalManageInfo">
        update `sgjs_technical_manage_info` set del_flag = "1"  , update_time=#{updateTime} , update_user=#{updateUser}
    </update>
