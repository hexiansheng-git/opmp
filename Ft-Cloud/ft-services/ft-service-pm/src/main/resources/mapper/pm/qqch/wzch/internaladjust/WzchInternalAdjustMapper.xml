    <sql id="selectWzchInternalAdjustVo">
        select ia.`id`,
               ia.`adjust_code`                                        as actCode,
               CONCAT(ia.`adjust_code`,
                      LPAD(0 + cast(ia.version_code AS CHAR), 2, '0')) as adjust_code,

               ia.`title`,
               ia.`region_id`,
               ia.`region_name`,
               CONCAT('V', ia.`version_code`)                                          as versionCodeStr,
               ia.`version_code`,
               ia.`limit_price_desc`,
               ia.`file_group_id`,
               ia.`remark`,
               ia.`project_id`,
               ia.`project_name`,
               ia.`dept_id`,
               ia.`create_user`,
               ia.`create_user_name`,
               ia.`create_time`,
               ia.`update_user`,
               ia.`update_user_name`,
               ia.`update_time`,
               ia.`del_user`,
               ia.`del_time`,
               ia.`del_flag`,
               ia.`valid`,
               ia.`pt_var1`,
               ia.`pt_var2`,
               ia.`pt_var3`,
               ia.`pt_var4`,
               ia.version 
        from `wzch_internal_adjust` as ia

    </sql>

    <select id="selectWzchInternalAdjustList" parameterType="com.hhwy.pm.qqch.wzch.internaladjust.domain.WzchInternalAdjust"
            resultMap="WzchInternalAdjustResult">
        <include refid="selectWzchInternalAdjustVo"/>
        <where>
            ia.`del_flag` = 0
            <if test="params.ids != null and params.ids != '' ">
                and ia.id in
                <foreach item="item" collection="params.ids.split(',')" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="adjustCode != null  and adjustCode != ''">and ia.`adjust_code` = #{adjustCode}</if>
            <if test="title != null  and title != ''">and ia.`title` LIKE CONCAT('%',#{title},'%')</if>
            <if test="regionId != null ">and ia.`region_id` = #{regionId}</if>
            <if test="region != null  and region != ''">and ia.`region_name` LIKE CONCAT('%',#{region},'%')</if>
            <if test="versionCode != null ">and ia.`version_code` = #{versionCode}</if>
            <if test="limitPriceDesc != null  and limitPriceDesc != ''">and ia.`limit_price_desc` = #{limitPriceDesc}
            </if>
            <if test="fileGroupId != null  and fileGroupId != ''">and ia.`file_group_id` = #{fileGroupId}</if>
            <if test="projectId != null ">and ia.`project_id` = #{projectId}</if>
            <if test="projectName != null  and projectName != ''">and ia.`project_name` like concat('%', #{projectName},
                '%')
            </if>
            <if test="deptId != null ">and ia.`dept_id` = #{deptId}</if>
            <if test="createUser != null  and createUser != ''">and ia.`create_user` = #{createUser}</if>
            <if test="createUserName != null  and createUserName != ''">and ia.`create_user_name` like concat('%',
                #{createUserName}, '%')
            </if>
            <if test="updateUser != null  and updateUser != ''">and ia.`update_user` = #{updateUser}</if>
            <if test="updateUserName != null  and updateUserName != ''">and ia.`update_user_name` like concat('%',
                #{updateUserName}, '%')
            </if>
            <if test="delUser != null  and delUser != ''">and ia.`del_user` = #{delUser}</if>
            <if test="delTime != null ">and ia.`del_time` = #{delTime}</if>
            <if test="valid != null  and valid != ''">and ia.`valid` = #{valid}</if>
            <if test="ptVar1 != null  and ptVar1 != ''">and ia.`pt_var1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''">and ia.`pt_var2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''">and ia.`pt_var3` = #{ptVar3}</if>
            <if test="ptVar4 != null  and ptVar4 != ''">and ia.`pt_var4` = #{ptVar4}</if>
            <if test="version != null ">and ia.`version` = #{version}</if>
        </where>
        ${params.dataScope}
        order by ia.`id` desc
    </select>

