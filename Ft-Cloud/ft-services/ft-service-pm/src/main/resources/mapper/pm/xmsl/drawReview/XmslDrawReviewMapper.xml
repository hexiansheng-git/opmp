    <!-- 有默认值的情况下 会有问题，建议遍历插入，调用insertXmslDrawReview -->
    <insert id="insertXmslDrawReviewList">
        insert into xmsl_draw_review
        <trim prefix="(" suffix=")" suffixOverrides=",">
            `id`,
            `version`,
            `valid`,
            `create_user`,
            `create_user_name`,
            `create_time`,
            `update_user`,
            `update_time`,
            `del_user`,
            `del_time`,
            `pt_var1`,
            `pt_var2`,
            `pt_var3`,
            `pt_var4`,
            `pt_var5`,
        </trim>
        values
        <foreach collection="xmslDrawReviewList" item="item" separator=",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{item.id},
                #{item.version},
                #{item.valid},
                #{item.createUser},
                #{item.createUserName},
                #{item.createTime},
