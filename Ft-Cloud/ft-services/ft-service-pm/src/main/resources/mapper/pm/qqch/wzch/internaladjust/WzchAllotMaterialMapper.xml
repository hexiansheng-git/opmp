    <select id="selectWzchAllotMaterialByProjectId"
            parameterType="com.hhwy.pm.qqch.wzch.internaladjust.domain.WzchAllotMaterial"
            resultMap="WzchInternalAdjustDetailResult">

        select
        am.`id`,
        am.`material_code`,
        am.`material_tech_param`,
        am.`material_standard`,
        am.`inventory`,
        am.`plan_enter_date` as adjustable_date,
        am.`project_ids`,
        am.`project_id` as adjust_project_id,
        am.`project_name`as adjust_project_name
        from `wzch_allot_material` AS am
        LEFT JOIN wzch_allot_material_range AS r on r.project_id = am.project_id and   r.del_flag = '0'
        <where>
            am.`del_flag` = 0
            <if test="materialCode != null  and materialCode != ''">and am.`material_code` = #{materialCode}</if>
            <if test="materialTechParam != null  and materialTechParam != ''">and am.`material_tech_param` =
                #{materialTechParam}
            </if>
            <if test="materialStandard != null  and materialStandard != ''">and am.`material_standard` =
                #{materialStandard}
            </if>
            <if test="inventory != null ">and am.`inventory` = #{inventory}</if>
            <if test="planEnterDate != null ">and am.`plan_enter_date` = #{planEnterDate}</if>
            <if test="projectIds != null ">and am.`project_ids` = #{projectIds}</if>
            <if test="projectId != null ">and am.`project_id` = #{projectId}</if>
            <if test="projectName != null  and projectName != ''">and am.`project_name` like concat('%', #{projectName},
                '%')
            </if>
            <if test="ancestors != null ">and am.`ancestors` = #{ancestors}</if>
            <if test="deptId != null ">and am.`dept_id` = #{deptId}</if>
            <if test="createUser != null  and createUser != ''">and am.`create_user` = #{createUser}</if>
            <if test="updateUser != null  and updateUser != ''">and am.`update_user` = #{updateUser}</if>
            <if test="delUser != null  and delUser != ''">and am.`del_user` = #{delUser}</if>
            <if test="delTime != null ">and am.`del_time` = #{delTime}</if>
            <if test="ptVar1 != null  and ptVar1 != ''">and am.`pt_var1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''">and am.`pt_var2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''">and am.`pt_var3` = #{ptVar3}</if>
            <if test="params.projectId != null  and params.projectId != ''">
                and FIND_IN_SET(#{params.projectId}, r.project_ids)
                <if test="params.codes != null">
                    and am.material_code = #{params.codes}
                </if>
            </if>

            <if test="params.projectIdList != null  and params.projectIdList != ''">
                and am.project_id IN
                <foreach item="item" collection="params.projectIdList.split(',')" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>

            <if test="params.materialCodes != null">
                and am.material_code IN
                <foreach item="item" collection="params.materialCodes" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>

        </where>
        order by am.`id` desc
    </select>


