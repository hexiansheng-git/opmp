<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hhwy.pm.xmsl.drawReview.mapper.XmslDrawReviewRelationMapper">

    <resultMap type="com.hhwy.pm.xmsl.drawReview.domain.XmslDrawReviewRelation"
               id="XmslDrawReviewRelationResultMap">
        <result property="mainId" column="main_id"/>
        <result property="wbsId" column="wbs_id"/>
        <result property="wbsCode" column="wbs_code"/>
        <result property="listCode" column="list_code"/>
        <result property="listId" column="list_id"/>
        <result property="version" column="version"/>
    </resultMap>
    <sql id="selectXmslDrawReviewRelationVo">
        select
                `main_id`
             ,`wbs_id`
             ,`wbs_code`
             ,`list_code`
             ,`list_id`,version
        from xmsl_draw_review_relation
    </sql>
    <select id="getXmslDrawReviewRelation" resultMap="XmslDrawReviewRelationResultMap">
        <include refid="selectXmslDrawReviewRelationVo"/>
        <where>
            del_flag = "0"
            <if test="mainId != null ">and `main_id` = #{mainId}</if>
            <if test="wbsId != null ">and `wbs_id` = #{wbsId}</if>
            <if test="wbsCode != null ">and `wbs_code` = #{wbsCode}</if>
            <if test="listCode != null  and listCode != ''">and `list_code` = #{listCode}</if>
            <if test="listId != null ">and `list_id` = #{listId}</if>
            <if test="version != null ">and `version` = #{version}</if>
        </where>
        order by create_time desc
    </select>

    <select id="getXmslDrawReviewRelationList" resultMap="XmslDrawReviewRelationResultMap">
        <include refid="selectXmslDrawReviewRelationVo"/>
        <where>
            <if test="mainId != null ">and `main_id` = #{mainId}</if>
            <if test="wbsId != null ">and `wbs_id` = #{wbsId}</if>
            <if test="wbsCode != null ">and `wbs_code` = #{wbsCode}</if>
            <if test="listCode != null  and listCode != ''">and `list_code` = #{listCode}</if>
            <if test="listId != null ">and `list_id` = #{listId}</if>
            <if test="version != null ">and `version` = #{version}</if>
            <if test="codeSet != null  and codeSet.size > 0 ">and `list_code` in
                <foreach collection="codeSet" index="index" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>

    <insert id="insertXmslDrawReviewRelation" useGeneratedKeys="true" keyProperty="wbs_id">
        insert into xmsl_draw_review_relation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="mainId != null ">`main_id`,</if>
            <if test="wbsId != null ">`wbs_id`,</if>
            <if test="wbsCode != null ">`wbs_code`,</if>
            <if test="listCode != null  and listCode != ''">`list_code`,</if>
            <if test="listId != null ">`list_id`,</if>
            <if test="version != null ">`version`,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="mainId != null ">#{mainId},</if>
            <if test="wbsId != null ">#{wbsId},</if>
            <if test="wbsCode != null ">#{wbsCode},</if>
            <if test="listCode != null  and listCode != ''">#{listCode},</if>
            <if test="listId != null ">#{listId},</if>
            <if test="version != null ">#{version},</if>
        </trim>
    </insert>

    <!-- 有默认值的情况下 会有问题，建议遍历插入，调用insertXmslDrawReviewRelation -->
    <insert id="insertXmslDrawReviewRelationList">
        insert into xmsl_draw_review_relation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            `main_id`,
            `wbs_id`,
            `wbs_code`,
            `list_code`,
            `list_id`,
            `version`
        </trim>
        values
        <foreach collection="xmslDrawReviewRelationList" item="item" separator=",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{item.mainId},
                #{item.wbsId},
                #{item.wbsCode},
                #{item.listCode},
                #{item.listId},
                #{item.version}
            </trim>
        </foreach>
    </insert>

    <update id="updateXmslDrawReviewRelation">
        update xmsl_draw_review_relation
        <trim prefix="SET" suffixOverrides=",">
            <if test="mainId != null ">`main_id` = #{mainId},</if>
            <if test="wbsId != null ">`wbs_id` = #{wbsId},</if>
            <if test="wbsCode != null ">`wbs_code` = #{wbsCode},</if>
            <if test="listCode != null  and  listCode != ''">`list_code` = #{listCode},</if>
            <if test="listId != null ">`list_id` = #{listId},</if>
            <if test="version != null ">`version` = #{version},</if>
        </trim>
        <where>
            <if test="mainId != null ">and `main_id` = #{mainId}</if>
            <if test="wbsId != null ">and `wbs_id` = #{wbsId}</if>
        </where>
    </update>

    <update id="updateXmslDrawReviewRelationList">
        update xmsl_draw_review_relation
        <trim prefix="set" suffixOverrides=",">
            <trim prefix="main_id  = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when `wbs_id`=#{item.wbsId} then #{item.mainId}
                </foreach>
            </trim>
            <trim prefix="wbs_id  = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when `wbs_id`=#{item.wbsId} then #{item.wbsId}
                </foreach>
            </trim>
            <trim prefix="wbs_code  = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when `wbs_id`=#{item.wbsId} then #{item.wbsCode}
                </foreach>
            </trim>
            <trim prefix="list_code  = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when `wbs_id`=#{item.wbsId} then #{item.listCode}
                </foreach>
            </trim>
            <trim prefix="list_id  = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when `wbs_id`=#{item.wbsId} then #{item.listId}
                </foreach>
            </trim>
            <trim prefix="version  = case" suffix="end,">
                <foreach collection="list" item="item" index="index">
                    when `wbs_id`=#{item.wbsId} then #{item.version}
                </foreach>
            </trim>
        </trim>
        where `wbs_id` in
        <foreach collection="wbsIdList" index="index" item="item" separator="," open="(" close=")">
            #{item.wbsId}
        </foreach>
    </update>

    <delete id="deleteXmslDrawReviewRelation">
        delete from `xmsl_draw_review_relation`
        <where>
            <if test="mainId != null ">and `main_id` = #{mainId}</if>
            <if test="wbsId != null ">and `wbs_id` = #{wbsId}</if>
            <if test="listCode != null  and listCode != ''">and `list_code` = #{listCode}</if>
            <if test="listId != null ">and `list_id` = #{listId}</if>
        </where>
    </delete>

    <delete id="deleteXmslDrawReviewRelationByPks">
        delete from `xmsl_draw_review_relation`
        <where>
            `wbs_id` in
            <foreach item="wbsId" collection="xmslDrawReviewRelationPkList" open="(" separator="," close=")">
                #{wbsId}
            </foreach>
        </where>
    </delete>
</mapper>