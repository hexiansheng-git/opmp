    <select id="personNumCalc" resultType="map">
        SELECT count(*) AS amountNum,
            count(IF(person_type = '中方', 1, NULL)) AS chinaNum,
            count(IF(person_type = '外方', 1, NULL)) AS foreignNum,
            CONCAT(truncate( ( count( IF ( person_type = '外方', 1, NULL ) ) / count( * ) ) , 0) , '%')  AS rateNum
        FROM qqch_management_person_config
        <include refid="dynamicWhere"/>
        AND pid != 0
    </select>

    <update id="savePersonType">
