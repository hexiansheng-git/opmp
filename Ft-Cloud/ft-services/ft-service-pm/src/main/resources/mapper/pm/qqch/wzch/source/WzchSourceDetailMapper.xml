    <select id="selectBySourceIdAndIdList" resultType="com.hhwy.pm.qqch.wzch.source.domain.WzchSourceDetail">
              select a.valid,a.`id`, a.`source_id` sourceId, a.`material_code` materialCode, a.`material_tech_param` materialTechParam,
        a.`material_standard` materialStandard, a.`total_demand_amount` totalDemandAmount, a.`self_demand_amount` selfDemandAmount,
         a.`file_group_id` fileGroupId, a.`remark`, a.`project_id` projectId, a.`project_name` projectName,
