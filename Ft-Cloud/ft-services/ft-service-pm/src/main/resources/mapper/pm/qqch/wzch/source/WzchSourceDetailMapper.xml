          b.`material_name` materialName, b.`material_spec` materialSpec,
            c.category_name categoryName,b.unit
          from `wzch_source_detail` a left join  t_material_info b on a.material_code = b.material_code
             left join t_material_category c on b.category_code = c.category_code
            where  a.del_flag = 0

