    <sql id="selectWzchPriorPurchaseVo">
        select wpp.`id`,wpp.version,
               wpp.prior_purchase_code                                  as actCode,
               CONCAT(wpp.`prior_purchase_code`,
                      LPAD(0 + cast(wpp.version_code AS CHAR), 2, '0')) as prior_purchase_code,
               wpp.`title`,
               wpp.`region_id`,
               wpp.`region_name`,
               wpp.`version_code`,
               CONCAT('V',wpp.`version_code`) as versionCodeStr,
               wpp.`limit_price_desc`,
               wpp.`file_group_id`,
               wpp.`remark`,
               wpp.`project_id`,
               wpp.`project_name`,
               wpp.`dept_id`,
               wpp.`create_user`,
               wpp.`create_user_name`,
               wpp.`create_time`,
               wpp.`update_user`,
               wpp.`update_user_name`,
               wpp.`update_time`,
               wpp.`del_user`,
               wpp.`del_time`,
               wpp.`del_flag`,
               wpp.`valid`,
               wpp.`pt_var1`,
               wpp.`pt_var2`,
               wpp.`pt_var3`,
               wpp.`pt_var4`,wpp.valid
        from `wzch_prior_purchase` as wpp
    </sql>

    <select id="selectWzchPriorPurchaseList" parameterType="com.hhwy.pm.qqch.wzch.priorpurchase.domain.WzchPriorPurchase"
            resultMap="WzchPriorPurchaseResult">
        <include refid="selectWzchPriorPurchaseVo"/>
        <where>
            wpp.`del_flag` = 0
            <if test="params.ids != null and params.ids != '' ">
                and wpp.id in
                <foreach item="item" collection="params.ids.split(',')" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="priorPurchaseCode != null  and priorPurchaseCode != ''">
                and wpp.`prior_purchase_code` = #{priorPurchaseCode}
            </if>
            <if test="title != null  and title != ''">
                and wpp.`title` LIKE CONCAT('%',#{title},'%')
            </if>
            <if test="regionId != null ">and wpp.`region_id` = #{regionId}</if>
            <if test="region != null  and region != ''">
                and wpp.`region_name` LIKE CONCAT('%',#{region},'%')
            </if>
            <if test="versionCode != null ">and wpp.`version_code` = #{versionCode}</if>
            <if test="limitPriceDesc != null  and limitPriceDesc != ''">
                and wpp.`limit_price_desc` = #{limitPriceDesc}
            </if>
            <if test="fileGroupId != null  and fileGroupId != ''">and wpp.`file_group_id` = #{fileGroupId}</if>
            <if test="projectId != null ">and wpp.`project_id` = #{projectId}</if>
            <if test="projectName != null  and projectName != ''">
                and wpp.`project_name` like concat('%', #{projectName}, '%')
            </if>
            <if test="deptId != null ">and wpp.`dept_id` = #{deptId}</if>
            <if test="createUser != null  and createUser != ''">and wpp.`create_user` = #{createUser}</if>
            <if test="createUserName != null  and createUserName != ''">and wpp.`create_user_name` like concat('%',
                #{createUserName}, '%')
            </if>
            <if test="updateUser != null  and updateUser != ''">and wpp.`update_user` = #{updateUser}</if>
            <if test="updateUserName != null  and updateUserName != ''">and wpp.`update_user_name` like concat('%',
                #{updateUserName}, '%')
            </if>
            <if test="delUser != null  and delUser != ''">and wpp.`del_user` = #{delUser}</if>
            <if test="delTime != null ">and wpp.`del_time` = #{delTime}</if>
            <if test="valid != null  and valid != ''">and wpp.`valid` = #{valid}</if>
            <if test="ptVar1 != null  and ptVar1 != ''">and wpp.`pt_var1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''">and wpp.`pt_var2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''">and wpp.`pt_var3` = #{ptVar3}</if>
            <if test="ptVar4 != null  and ptVar4 != ''">and wpp.`pt_var4` = #{ptVar4}</if>
            <if test="version != null  ">and wpp.`version` = #{version}</if>
            
        </where>
        ${params.dataScope}
        order by wpp.`id` desc
    </select>

    <select id="selectWzchPriorPurchaseById" parameterType="Long" resultMap="WzchPriorPurchaseResult">
        <include refid="selectWzchPriorPurchaseVo"/>
