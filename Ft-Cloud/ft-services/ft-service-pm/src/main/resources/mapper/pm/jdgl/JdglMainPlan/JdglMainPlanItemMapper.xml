        del_flag = "0" and main_plan_id = #{mainPlanId}
        and start_date &lt;= #{date} and finish_date &gt;= #{date}
        </where>
    </select>
    <select id="getUsingJdglMainPlanItemListByDateRange" resultMap="JdglMainPlanItemResultMap">
        <include refid="selectJdglMainPlanItemVo" />
        <where>
        del_flag = "0" and main_plan_id = #{mainPlanId}
        and ((start_date &lt;= #{startDate} and finish_date &gt;= #{startDate})
        or (start_date &lt;= #{finishDate} and finish_date &gt;= #{finishDate})
        or (start_date &gt;= #{startDate} and finish_date &lt;= #{finishDate}))
        </where>
    </select>

