    <select id="getMtlDetailList" resultMap="WzchInternalAdjustDetailResult">

        SELECT *
        FROM (
                 SELECT sd.id,
                        sd.material_code,
                        concat(sd.material_code, '_', tdd.material_standard) materialCodeAndStandard,
                     /*物资总需信息*/
                        tdd.material_tech_param,
                        tdd.material_standard,
                        tdd.total_demand_amount,
                        tdd.category_name,
                     /*来源策划需用量*/
                        SUM(IFNULL(sayc.inner_adjust_num, 0)) AS            inner_adjust_num
                 FROM `wzch_source_detail` AS sd
                          LEFT JOIN wzch_source_approach_year_count AS sayc ON sd.id = sayc.detail_id
                     /*查询物资总需信息*/
                          LEFT JOIN wzch_total_demand_detail AS tdd ON 
                     tdd.material_code = sd.material_code
                     AND tdd.material_standard = sd.material_standard
                     AND tdd.del_flag = 0
                 WHERE tdd.material_code = sd.material_code
                   AND tdd.material_standard = sd.material_standard
                   and sd.version = #{version}
                   AND tdd.del_flag = '0'
                   AND sd.del_flag = '0'
                 GROUP BY sayc.material_code,
                          sayc.detail_id
             ) AS temp
        WHERE temp.inner_adjust_num > 0

        order by temp.material_code asc


    </select>


