    <sql id="selectWzchInternalAdjustDetailVo">
        SELECT
            iad.`id`,
/*物资总需信息*/
            tdd.material_tech_param,
            tdd.total_demand_amount,
            tdd.category_name,
/*来源策划需用量*/
            iad.inner_adjust_num,
/*内部调剂材料策划*/
            iad.`internal_adjust_id`,
            iad.`material_code`,
            concat( iad.material_code, '_', iad.material_standard ) materialCodeAndStandard,
            iad.`brand`,
            iad.`material_standard`,
            iad.`plan_req_date`,
            iad.`adjustable_num`,
            iad.`adjust_project_id`,
            iad.`adjust_project_name`,
            iad.`adjustable_date`,
            iad.`adjust_unit_price`,
            iad.`currency`,
            iad.`total_price`,
            iad.`file_group_id`,
            iad.`remark`,
            iad.`project_id`,
            iad.`project_name`,
            iad.`dept_id`,
            iad.`create_user`,
            iad.`create_user_name`,
            iad.`create_time`,
            iad.`update_user`,
            iad.`update_user_name`,
            iad.`update_time`,
            iad.`del_user`,
            iad.`del_time`,
            iad.`del_flag`,
            iad.`pt_var1`,
            iad.`pt_var2`,
            iad.`pt_var3`
        FROM
            `wzch_internal_adjust_detail` AS iad /*查询物资总需信息*/
                LEFT JOIN wzch_total_demand_detail AS tdd ON 
                tdd.material_code = iad.material_code
                AND tdd.material_standard = iad.material_standard
                AND tdd.del_flag = 0

    </sql>

    <select id="selectWzchInternalAdjustDetailList"
            parameterType="com.hhwy.pm.qqch.wzch.internaladjust.domain.WzchInternalAdjustDetail"
            resultMap="WzchInternalAdjustDetailResult">
        <include refid="selectWzchInternalAdjustDetailVo"/>
        <where>
            iad.`del_flag` = 0
            AND tdd.material_code = iad.material_code
            AND tdd.material_standard = iad.material_standard
            AND tdd.del_flag = 0
            <if test="internalAdjustId != null ">and iad.`internal_adjust_id` = #{internalAdjustId}</if>
            <if test="materialCode != null  and materialCode != ''">and iad.`material_code` = #{materialCode}</if>
            <if test="materialTechParam != null  and materialTechParam != ''">and iad.`material_tech_param` =
                #{materialTechParam}
            </if>
            <if test="brand != null  and brand != ''">and iad.`brand` = #{brand}</if>
            <if test="materialStandard != null  and materialStandard != ''">and iad.`material_standard` =
                #{materialStandard}
            </if>
            <if test="totalDemandAmount != null ">and iad.`total_demand_amount` = #{totalDemandAmount}</if>
            <if test="innerAdjustNum != null ">and iad.`inner_adjust_num` = #{innerAdjustNum}</if>
            <if test="planReqDate != null ">and iad.`plan_req_date` = #{planReqDate}</if>
            <if test="adjustableNum != null ">and iad.`adjustable_num` = #{adjustableNum}</if>
            <if test="adjustProjectId != null ">and iad.`adjust_project_id` = #{adjustProjectId}</if>
            <if test="adjustProjectName != null  and adjustProjectName != ''">and iad.`adjust_project_name` like
                concat('%',
                #{adjustProjectName}, '%')
            </if>
            <if test="adjustableDate != null ">and iad.`adjustable_date` = #{adjustableDate}</if>
            <if test="adjustUnitPrice != null ">and iad.`adjust_unit_price` = #{adjustUnitPrice}</if>
            <if test="currency != null  and currency != ''">and iad.`currency` = #{currency}</if>
            <if test="totalPrice != null ">and iad.`total_price` = #{totalPrice}</if>
            <if test="fileGroupId != null  and fileGroupId != ''">and iad.`file_group_id` = #{fileGroupId}</if>
            <if test="projectId != null ">and iad.`project_id` = #{projectId}</if>
            <if test="projectName != null  and projectName != ''">and iad.`project_name` like concat('%',
                #{projectName},
                '%')
            </if>
            <if test="deptId != null ">and iad.`dept_id` = #{deptId}</if>
            <if test="createUser != null  and createUser != ''">and iad.`create_user` = #{createUser}</if>
            <if test="createUserName != null  and createUserName != ''">and iad.`create_user_name` like concat('%',
                #{createUserName}, '%')
            </if>
            <if test="updateUser != null  and updateUser != ''">and iad.`update_user` = #{updateUser}</if>
            <if test="updateUserName != null  and updateUserName != ''">and iad.`update_user_name` like concat('%',
                #{updateUserName}, '%')
            </if>
            <if test="delUser != null  and delUser != ''">and iad.`del_user` = #{delUser}</if>
            <if test="delTime != null ">and iad.`del_time` = #{delTime}</if>
            <if test="ptVar1 != null  and ptVar1 != ''">and iad.`pt_var1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''">and iad.`pt_var2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''">and iad.`pt_var3` = #{ptVar3}</if>
        </where>
        order by iad.`material_code` asc
    </select>

