    <select id="selectMaxVersion" resultType="java.math.BigDecimal"
            parameterType="com.hhwy.pm.qqch.preparation.safe.risk.domain.vo.QqchSafeRiskControlPlanVo">
        select ifnull(max(version), 1)
        from qqch_safe_risk_list
        where del_flag = '0'
          and valid = '1'
          and type = #{type}
        order by version desc;
    </select>
    <select id="selectLessOrEqualAssignVersion" resultType="java.math.BigDecimal"
            parameterType="com.hhwy.pm.qqch.preparation.safe.risk.domain.vo.QqchSafeRiskControlPlanVo">
        select version
        from qqch_safe_risk_list
        where del_flag = '0'
          and version &lt;= #{version}
          and type = #{type}
        group by version
        order by version desc limit 1
    </select>
