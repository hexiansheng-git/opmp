    <sql id="selectWzchPriorPurchaseDetailVo">
        SELECT ppd.`id`,
            /*物资总需信息*/
               tdd.material_tech_param,
               tdd.material_standard,
               tdd.total_demand_amount,
               tdd.self_demand_amount,
               tdd.category_name,

            /*优先进场物资信息*/
               pad.prior_approach_num as prior_approach_amount,
               pad.earliest_req_time,
               pad.present_time,

               ppd.`prior_purchase_id`,
               ppd.`material_code`,
               ppd.`brand`,
               ppd.`source`,
               ppd.`currency`,
               ppd.`unit_price`,
               ppd.`total_price`,
               ppd.`file_group_id`,
               ppd.`remark`,
               ppd.`project_id`,
               ppd.`project_name`,
               ppd.`dept_id`,
               ppd.`create_user`,
               ppd.`create_user_name`,
               ppd.`create_time`,
               ppd.`update_user`,
               ppd.`update_user_name`,
               ppd.`update_time`,
               ppd.`del_user`,
               ppd.`del_time`,
               ppd.`del_flag`,
               ppd.`pt_var1`,
               ppd.`pt_var2`,
               ppd.`pt_var3`
        FROM `wzch_prior_purchase_detail` AS ppd
                 /*查询物资总需信息*/
                 LEFT JOIN wzch_total_demand_detail AS tdd
            on tdd.material_code = ppd.material_code
            AND tdd.material_standard = ppd.material_standard
            AND tdd.del_flag = 0
            /*查询优先进场物资信息*/
             LEFT JOIN wzch_prior_approach_detail AS pad
            ON pad.del_flag = '0'
            AND pad.material_code = ppd.material_code
            AND pad.material_standard = ppd.material_standard

    </sql>

    <select id="selectWzchPriorPurchaseDetailList"
            parameterType="com.hhwy.pm.qqch.wzch.priorpurchase.domain.WzchPriorPurchaseDetail"
            resultMap="WzchPriorPurchaseDetailResult">
        <include refid="selectWzchPriorPurchaseDetailVo"/>
        <where>
            ppd.`del_flag` = 0
            <if test="priorPurchaseId != null ">and ppd.`prior_purchase_id` = #{priorPurchaseId}</if>
            <if test="materialCode != null  and materialCode != ''">and ppd.`material_code` = #{materialCode}</if>
            <if test="brand != null  and brand != ''">and ppd.`brand` = #{brand}</if>
            <if test="source != null  and source != ''">and ppd.`source` = #{source}</if>
            <if test="currency != null  and currency != ''">and ppd.`currency` = #{currency}</if>
            <if test="unitPrice != null ">and ppd.`unit_price` = #{unitPrice}</if>
            <if test="avgPurchasePrice != null ">and ppd.`avg_purchase_price` = #{avgPurchasePrice}</if>
            <if test="avgDespatchPrice != null ">and ppd.`avg_despatch_price` = #{avgDespatchPrice}</if>
            <if test="avgCustClearPrice != null ">and ppd.`avg_cust_clear_price` = #{avgCustClearPrice}</if>
            <if test="avgLocalTransportPrice != null ">and ppd.`avg_local_transport_price` = #{avgLocalTransportPrice}
            </if>
            <if test="avgLandingPrice != null ">and ppd.`avg_landing_price` = #{avgLandingPrice}</if>
            <if test="totalPrice != null ">and ppd.`total_price` = #{totalPrice}</if>
            <if test="fileGroupId != null  and fileGroupId != ''">and ppd.`file_group_id` = #{fileGroupId}</if>
            <if test="projectId != null ">and ppd.`project_id` = #{projectId}</if>
            <if test="projectName != null  and projectName != ''">and ppd.`project_name` like concat('%',
                #{projectName}, '%')
            </if>
            <if test="deptId != null ">and ppd.`dept_id` = #{deptId}</if>
            <if test="createUser != null  and createUser != ''">and ppd.`create_user` = #{createUser}</if>
            <if test="createUserName != null  and createUserName != ''">and ppd.`create_user_name` like concat('%',
                #{createUserName}, '%')
            </if>
            <if test="updateUser != null  and updateUser != ''">and ppd.`update_user` = #{updateUser}</if>
            <if test="updateUserName != null  and updateUserName != ''">and ppd.`update_user_name` like concat('%',
                #{updateUserName}, '%')
            </if>
            <if test="delUser != null  and delUser != ''">and ppd.`del_user` = #{delUser}</if>
            <if test="delTime != null ">and ppd.`del_time` = #{delTime}</if>
            <if test="ptVar1 != null  and ptVar1 != ''">and ppd.`pt_var1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''">and ppd.`pt_var2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''">and ppd.`pt_var3` = #{ptVar3}</if>

            <!-- 2023年6月27日10:44:23  添加-->
            <if test="planPurchaseDateStart != null  and planPurchaseDateEnd != null ">and pad.earliest_req_time between #{planPurchaseDateStart} and #{planPurchaseDateEnd}</if>
            <if test="valid != null  and valid != '' ">and ppd.`valid` =#{valid}</if>
        </where>
        order by ppd.`material_code` asc
    </select>

    <select id="selectWzchPriorPurchaseDetailById" parameterType="Long" resultMap="WzchPriorPurchaseDetailResult">
        <include refid="selectWzchPriorPurchaseDetailVo"/>
        where ppd.`id` = #{id}
        AND pad.material_code = ppd.material_code
        AND tdd.material_code = ppd.material_code
