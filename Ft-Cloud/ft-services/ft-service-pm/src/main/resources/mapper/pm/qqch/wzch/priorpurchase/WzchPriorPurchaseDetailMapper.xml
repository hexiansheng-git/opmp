        VALUES
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.id},
            #{entity.priorPurchaseId},
            #{entity.materialCode},
            #{entity.materialStandard},
            #{entity.brand},
            #{entity.source},
            #{entity.currency},
            #{entity.unitPrice},
            #{entity.avgPurchasePrice},
            #{entity.avgDespatchPrice},
            #{entity.avgCustClearPrice},
            #{entity.avgLocalTransportPrice},
            #{entity.avgLandingPrice},
            #{entity.totalPrice},
            #{entity.fileGroupId},
            #{entity.remark},
            #{entity.projectId},
            #{entity.projectName},
            #{entity.deptId},
            #{entity.createUser},
            #{entity.createUserName},
            #{entity.createTime},
            #{entity.updateUser},
            #{entity.updateUserName},
            #{entity.updateTime},
            #{entity.delUser},
            #{entity.delTime},
            #{entity.delFlag},
            #{entity.valid},
            #{entity.ptVar1},
            #{entity.ptVar2},
            #{entity.ptVar3})
        </foreach>
        ON DUPLICATE KEY UPDATE
        prior_purchase_id = VALUES( prior_purchase_id ),
        material_code = VALUES( material_code ),
        brand = VALUES( brand ),
        source = VALUES( source ),
        currency = VALUES( currency ),
        unit_price = VALUES( unit_price ),
        avg_purchase_price = VALUES( avg_purchase_price ),
        avg_despatch_price = VALUES( avg_despatch_price ),
        avg_cust_clear_price = VALUES( avg_cust_clear_price ),
        avg_local_transport_price = VALUES( avg_local_transport_price ),
        avg_landing_price = VALUES( avg_landing_price ),
        total_price = VALUES( total_price ),
        file_group_id = VALUES( file_group_id ),
        remark = VALUES( remark ),
        project_id = VALUES( project_id ),
        project_name = VALUES( project_name ),
        dept_id = VALUES( dept_id ),
        create_user = VALUES( create_user ),
        create_user_name = VALUES( create_user_name ),
        create_time = VALUES( create_time ),
        update_user = VALUES( update_user ),
        update_user_name = VALUES( update_user_name ),
        update_time = VALUES( update_time ),
        del_user = VALUES( del_user ),
        del_time = VALUES( del_time ),
        del_flag = VALUES( del_flag ),
        valid = VALUES( valid ),
        pt_var1 = VALUES( pt_var1 ),
        pt_var2 = VALUES( pt_var2 ),
        pt_var3 = VALUES(pt_var3)
    </insert>
    <delete id="deleteByPurchaseId">
        delete
        from wzch_prior_purchase_detail
        where prior_purchase_id = #{purchaseId}
    </delete>
    <update id="deleteByPriorPurchaseIds">
        update `wzch_prior_purchase_detail` set del_flag = 1 where `prior_purchase_id` in
        <foreach item="id" collection="priorPurchaseIds" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>


    <select id="getMtlDetailList" resultMap="WzchPriorPurchaseDetailResult">

        SELECT
        pad.`id`,
        tdd.project_id AS totalPrjId,
        pad.project_id AS priorPrjId,
        pad.material_code,
        /*物资总需信息*/
        tdd.material_tech_param,
        tdd.material_standard,
        tdd.total_demand_amount,
        tdd.self_demand_amount,
        tdd.category_name,
        /*优先进场物资信息*/
        pad.prior_approach_num AS prior_approach_amount,
        pad.earliest_req_time,
        pad.present_time
        FROM
        `wzch_prior_approach_detail` as pad
        /*查询物资总需信息*/
        LEFT JOIN wzch_total_demand_detail AS tdd ON
        tdd.material_code = pad.material_code
        AND tdd.material_standard = pad.material_standard
        AND tdd.del_flag = 0

        <where>
            pad.del_flag = 0
            AND tdd.material_code = pad.material_code
            AND tdd.material_standard = pad.material_standard
            AND tdd.del_flag = 0
            <if test="projectId != null ">AND pad.`project_id` = #{projectId}</if>
        </where>
        ORDER BY pad.material_code ASC
    </select>

    <resultMap type="com.hhwy.pm.qqch.wzch.puchasesupply.dto.WzchPurchaseSupplyDetailDTO" id="WzchPurchaseSupplyDetailResult">
        <result property="materialCode" column="material_code"/>
        <result property="materialStandard" column="material_standard"/>
        <result property="internalNum" column="internal_num"/>
        <result property="otherStateNum" column="other_state_num"/>
        <result property="localNum" column="local_num"/>
    </resultMap>

    <select id="selectPurchaseSource" resultMap="WzchPurchaseSupplyDetailResult">

        SELECT
        pad.material_code,
        pad.material_standard,
        sum( payc.internal_num ) AS internal_num,
        sum( payc.other_state_num ) AS other_state_num,
        sum( payc.local_num ) AS local_num
        FROM
        wzch_prior_approach_detail AS pad
        LEFT JOIN wzch_prior_approach_year_count AS payc ON pad.id = payc.detail_id
        WHERE
        pad.material_code IN
        <foreach item="code" collection="materialCodeList" open="(" separator="," close=")">
            #{code}
        </foreach>
        GROUP BY
        pad.material_code, pad.material_standard;


    </select>

</mapper>