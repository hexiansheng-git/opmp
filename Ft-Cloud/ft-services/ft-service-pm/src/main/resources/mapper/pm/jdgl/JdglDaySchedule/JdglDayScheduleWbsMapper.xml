    <select id="getWbsListByDateRange4Value"
            resultType="com.hhwy.pm.jdgl.day.schedule.jdglDayScheduleWbs.domain.JdglDayScheduleWbs4Value">
        select wd.wbs_id id,wd.wbs_pid pid,wd.wbs_code,wd.wbs_name,wd.unit,wd.design_quantity,
               sum(wd.this_quantity) this_quantity,sum(wd.this_value) this_value from (
            select jdsw.wbs_id,jdsw.wbs_pid,jdsw.wbs_code,jdsw.wbs_name,jdsw.unit,jdsw.design_quantity,jdsw.this_quantity,sum(jdsb.bill_value) this_value
                from (select * from jdgl_day_schedule where `date` &gt;= #{startDate} and `date` &lt;= #{endDate} and task_status = "5") jds
                inner join jdgl_day_schedule_wbs jdsw
                          on jds.id = jdsw.day_schedule_id
                inner join jdgl_day_schedule_bill jdsb
                          on jds.id = jdsb.day_schedule_id
                              and jdsw.wbs_code = jdsb.wbs_code
                group by jdsw.wbs_id,jdsw.wbs_pid,jdsw.wbs_code,jdsw.wbs_name,jdsw.unit,jdsw.design_quantity,jdsw.this_quantity
                order by sort asc
        ) wd group by wd.wbs_id,wd.wbs_pid,wd.wbs_code,wd.wbs_name,wd.unit,wd.design_quantity
    </select>

    <select id="getTotalWbsListByDateRange4Value"
