    <sql id="selectWzchSpecialProjectVo">
        select sp.`id`,
               sp.`special_project_code`                               as actCode,
               CONCAT(sp.`special_project_code`,
                      LPAD(0 + cast(sp.version_code AS CHAR), 2, '0')) as special_project_code,
               sp.`special_project_code`,
               sp.`title`,
               sp.`region_id`,
               sp.`region_name`,
               sp.`version_code`,
               CONCAT('V', sp.`version_code`)                                          as versionCodeStr,
               sp.`limit_price_desc`,
               sp.`file_group_id`,
               sp.`remark`,
               sp.`project_id`,
               sp.`project_name`,
               sp.`dept_id`,
               sp.`create_user`,
               sp.`create_user_name`,
               sp.`create_time`,
               sp.`update_user`,
               sp.`update_user_name`,
               sp.`update_time`,
               sp.`del_user`,
               sp.`del_time`,
               sp.`del_flag`,
               sp.`valid`,
               sp.`pt_var1`,
               sp.`pt_var2`,
               sp.`pt_var3`,
               sp.`pt_var4`
        from `wzch_special_project` as sp

    </sql>


    <select id="selectWzchSpecialProjectList" parameterType="com.hhwy.pm.qqch.wzch.specialproject.domain.WzchSpecialProject"
            resultMap="WzchSpecialProjectResult">
        <include refid="selectWzchSpecialProjectVo"/>
        <where>
            sp.`del_flag` = 0
            <if test="params.ids != null and params.ids != '' ">
                and sp.id in
                <foreach item="item" collection="params.ids.split(',')" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>

            <if test="specialProjectCode != null  and specialProjectCode != ''">and sp.`special_project_code` =
                #{specialProjectCode}
            </if>
            <if test="title != null  and title != ''">and sp.`title` LIKE CONCAT('%',#{title},'%')</if>
            <if test="regionId != null ">and sp.`region_id` = #{regionId}</if>
            <if test="region != null  and region != ''">and sp.`region_name` like concat('%', #{region},
                '%')
            </if>
            <if test="versionCode != null ">and sp.`version_code` = #{versionCode}</if>
            <if test="limitPriceDesc != null  and limitPriceDesc != ''">and sp.`limit_price_desc` = #{limitPriceDesc}
            </if>
            <if test="fileGroupId != null  and fileGroupId != ''">and sp.`file_group_id` = #{fileGroupId}</if>
            <if test="projectId != null ">and sp.`project_id` = #{projectId}</if>
            <if test="projectName != null  and projectName != ''">and sp.`project_name` like concat('%', #{projectName},
                '%')
            </if>
            <if test="deptId != null ">and sp.`dept_id` = #{deptId}</if>
            <if test="createUser != null  and createUser != ''">and sp.`create_user` = #{createUser}</if>
            <if test="createUserName != null  and createUserName != ''">and sp.`create_user_name` like concat('%',
                #{createUserName}, '%')
            </if>
            <if test="updateUser != null  and updateUser != ''">and sp.`update_user` = #{updateUser}</if>
            <if test="updateUserName != null  and updateUserName != ''">and sp.`update_user_name` like concat('%',
                #{updateUserName}, '%')
            </if>
            <if test="delUser != null  and delUser != ''">and sp.`del_user` = #{delUser}</if>
            <if test="delTime != null ">and sp.`del_time` = #{delTime}</if>
            <if test="valid != null  and valid != ''">and sp.`valid` = #{valid}</if>
            <if test="ptVar1 != null  and ptVar1 != ''">and sp.`pt_var1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''">and sp.`pt_var2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''">and sp.`pt_var3` = #{ptVar3}</if>
            <if test="ptVar4 != null  and ptVar4 != ''">and sp.`pt_var4` = #{ptVar4}</if>
        </where>
        ${params.dataScope}
        order by sp.`id` desc
    </select>

