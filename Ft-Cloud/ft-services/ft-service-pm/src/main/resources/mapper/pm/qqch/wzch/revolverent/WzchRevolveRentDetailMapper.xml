    <select id="getMtlDetailList" resultMap="WzchRevolveRentDetailResult">

        SELECT *
        FROM (
                 SELECT
                     /*来源信息*/
                     sd.id,
                     SUM(ifnull(sayc.rent_num, 0)) AS rent_num,
                     sd.`material_code`,
                     /*优先进场的品牌 优先进场中有，则从优先进场中获取*/
                     ppd.brand,
                     /*物资总需信息*/
                     tdd.id                        AS totalId,
                     tdd.material_tech_param,
                     tdd.material_standard,
                     tdd.total_demand_amount,
                     tdd.category_name

                 FROM wzch_source_detail AS sd
                          LEFT JOIN wzch_source_approach_year_count AS sayc ON sd.id = sayc.detail_id

                     /* 关联物资总需*/
                          LEFT JOIN wzch_total_demand_detail AS tdd ON 
                     tdd.material_code = sd.material_code
                     AND tdd.material_standard = sd.material_standard
                     AND tdd.del_flag = 0

                     /* 关联优先进场物资策划 */
                          LEFT JOIN wzch_prior_purchase_detail AS ppd ON 
                     ppd.material_code = sd.material_code
                     AND ppd.material_standard = sd.material_standard
                     AND ppd.del_flag = 0
                 WHERE tdd.material_code = sd.material_code
                   AND tdd.material_standard = sd.material_standard
                   AND tdd.del_flag = 0
                     /*类型为 周转材 的数据*/
                   AND tdd.category_name = '2'
                 GROUP BY sayc.material_code,
                          sayc.detail_id
             ) AS temp
        WHERE temp.rent_num > 0
        ORDER BY temp.material_code ASC
    </select>


