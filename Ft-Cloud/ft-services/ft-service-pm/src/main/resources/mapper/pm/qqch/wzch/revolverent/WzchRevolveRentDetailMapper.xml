    <select id="selectWzchRevolveRentDetailList" parameterType="com.hhwy.pm.qqch.wzch.revolverent.domain.WzchRevolveRentDetail"
            resultMap="WzchRevolveRentDetailResult">
        SELECT
        rrd.`id`,
        rrd.`material_code`,

        /****************物资总需信息****************/
        tdd.id AS totalId,
        /*技术参数*/
        tdd.material_tech_param,
        /*执行标准*/
        tdd.material_standard,
        /*总需用量*/
        tdd.total_demand_amount,
        /*类型*/
        tdd.category_name,
        /****************物资总需信息****************/

        /****************来源策划租赁数据****************/
        /*租赁需用量*/
        SUM(IFNULL(sayc.rent_num ,0))as rent_num,


        rrd.`revolve_rent_id`,
        rrd.`brand`,
        rrd.`currency`,
        rrd.`unit_price`,
        rrd.`plan_enter_date`,
        rrd.`rent_days`,
        rrd.`plan_exit_date`,
        rrd.`other_cost`,
        rrd.`total_price`,
        rrd.`project_id`,
        rrd.`project_name`,
        rrd.`remark`
        FROM
        `wzch_revolve_rent_detail` AS rrd

        /* 关联物资总需*/
        LEFT JOIN wzch_total_demand_detail AS tdd ON tdd.material_code = rrd.material_code
        AND tdd.material_standard = rrd.material_standard
        AND tdd.del_flag = 0

        /* 关联来源策划*/
        LEFT JOIN wzch_source_detail AS sd ON
        sd.material_code = rrd.material_code
        AND sd.material_standard = rrd.material_standard
        AND sd.del_flag = 0
        LEFT JOIN wzch_source_approach_year_count AS sayc ON sd.id = sayc.detail_id
        <where>
            rrd.`del_flag` = 0
          /*  AND sd.material_code = rrd.material_code
            AND sd.material_standard = rrd.material_standard
            AND sd.del_flag = 0
            AND tdd.material_code = rrd.material_code
            AND tdd.material_standard = rrd.material_standard
            AND tdd.valid = 1
            AND tdd.del_flag = 0*/
            <if test="revolveRentId != null ">and rrd.`revolve_rent_id` = #{revolveRentId}</if>
            <if test="materialCode != null  and materialCode != ''">and rrd.`material_code` = #{materialCode}</if>
            <if test="materialTechParam != null  and materialTechParam != ''">and rrd.`material_tech_param` =
                #{materialTechParam}
            </if>
            <if test="brand != null  and brand != ''">and rrd.`brand` = #{brand}</if>
            <if test="materialStandard != null  and materialStandard != ''">and rrd.`material_standard` =
                #{materialStandard}
            </if>
            <if test="totalDemandAmount != null ">and rrd.`total_demand_amount` = #{totalDemandAmount}</if>
            <if test="rentNum != null ">and rrd.`rent_num` = #{rentNum}</if>
            <if test="currency != null  and currency != ''">and rrd.`currency` = #{currency}</if>
            <if test="unitPrice != null ">and rrd.`unit_price` = #{unitPrice}</if>
            <if test="planEnterDate != null ">and rrd.`plan_enter_date` = #{planEnterDate}</if>
            <if test="rentDays != null ">and rrd.`rent_days` = #{rentDays}</if>
            <if test="planExitDate != null ">and rrd.`plan_exit_date` = #{planExitDate}</if>
            <if test="otherCost != null ">and rrd.`other_cost` = #{otherCost}</if>
            <if test="totalPrice != null ">and rrd.`total_price` = #{totalPrice}</if>
            <if test="fileGroupId != null  and fileGroupId != ''">and rrd.`file_group_id` = #{fileGroupId}</if>
            <if test="projectId != null ">and rrd.`project_id` = #{projectId}</if>
            <if test="projectName != null  and projectName != ''">and rrd.`project_name` like concat('%',
                #{projectName},
                '%')
            </if>
            <if test="deptId != null ">and rrd.`dept_id` = #{deptId}</if>
            <if test="createUser != null  and createUser != ''">and rrd.`create_user` = #{createUser}</if>
            <if test="createUserName != null  and createUserName != ''">and rrd.`create_user_name` like concat('%',
                #{createUserName}, '%')
            </if>
            <if test="updateUser != null  and updateUser != ''">and rrd.`update_user` = #{updateUser}</if>
            <if test="updateUserName != null  and updateUserName != ''">and rrd.`update_user_name` like concat('%',
                #{updateUserName}, '%')
            </if>
            <if test="delUser != null  and delUser != ''">and rrd.`del_user` = #{delUser}</if>
            <if test="delTime != null ">and rrd.`del_time` = #{delTime}</if>
            <if test="ptVar1 != null  and ptVar1 != ''">and rrd.`pt_var1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''">and rrd.`pt_var2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''">and rrd.`pt_var3` = #{ptVar3}</if>
            <if test="valid != null  and valid != ''">and rrd.`valid` = #{valid}</if>
        </where>
        GROUP BY rrd.material_code, sayc.detail_id

        order by rrd.`material_code` asc
    </select>

