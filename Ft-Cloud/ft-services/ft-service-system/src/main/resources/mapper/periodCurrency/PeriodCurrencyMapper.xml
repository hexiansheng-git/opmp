    <sql id="selectPeriodCurrencyVo">
        select `id`, `period_id`, `period_code`, `currency_id`, `rate`, `create_user`, `create_time`, `update_user`, `update_time`, `del_user`, `del_time`, `del_flag`, `remark`, `pt_var1`, `pt_var2`, `pt_var3` from `t_period_currency`
    </sql>

    <select id="selectPeriodCurrencyList" parameterType="com.hhwy.domain.base.system.periodCurrency.PeriodCurrency" resultMap="PeriodCurrencyResult">
        <include refid="selectPeriodCurrencyVo"/>
        <where>
            `del_flag` = 0
            <if test="periodId != null  and periodId != ''"> and `period_id` = #{periodId}</if>
            <if test="periodCode != null  and periodCode != ''"> and `period_code` like concat('%', #{periodCode}, '%') </if>
            <if test="currencyId != null  and currencyId != ''"> and `currency_id` = #{currencyId}</if>
            <if test="rate != null "> and `rate` = #{rate}</if>
            <if test="createUser != null  and createUser != ''"> and `create_user` = #{createUser}</if>
            <if test="updateUser != null  and updateUser != ''"> and `update_user` = #{updateUser}</if>
            <if test="delUser != null  and delUser != ''"> and `del_user` = #{delUser}</if>
            <if test="delTime != null "> and `del_time` = #{delTime}</if>
            <if test="ptVar1 != null  and ptVar1 != ''"> and `pt_var1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''"> and `pt_var2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''"> and `pt_var3` = #{ptVar3}</if>
        </where>
        order by `id` desc
    </select>
    
    <select id="selectPeriodCurrencyById" parameterType="Long" resultMap="PeriodCurrencyResult">
        <include refid="selectPeriodCurrencyVo"/>
        where `id` = #{id}
    </select>

    <select id="selectRatePeriodByCodeAndCurrent" resultMap="PeriodCurrencyResult">

        SELECT
        pc.`id`,
        pc.`period_id`,
        pc.`period_code`,
        pc.`currency_id`,
        pc.`rate`,
        tmp.currency_code
        FROM
        t_currency_info as tmp
        LEFT JOIN t_period_currency AS pc ON tmp.id = pc.currency_id
        WHERE pc.period_code = #{periodCode}
        AND pc.del_flag = '0'
        AND tmp.currency_code in
        <foreach item="item" collection="currency.split(',')" open="(" separator="," close=")">
            #{item}
        </foreach>

    </select>
