    <insert id="insertTWarn" useGeneratedKeys="true" keyProperty="warn_id">
        insert into t_warn
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="warnId != null ">`warn_id`,</if>
            <if test="warnItem != null  and warnItem != ''">`warn_item`,</if>
            <if test="warnItemId != null  and warnItemId != ''">`warn_item_id`,</if>
            <if test="warnUserId != null  and warnUserId != ''">`warn_user_id`,</if>
            <if test="warnUserName != null  and warnUserName != ''">`warn_user_name`,</if>
            <if test="warnContent != null  and warnContent != ''">`warn_content`,</if>
            <if test="warnStatus != null  and warnStatus != ''">`warn_status`,</if>
            <if test="warnType != null  and warnType != ''">`warn_type`,</if>
            <if test="warnUrl != null  and warnUrl != ''">`warn_url`,</if>
            <if test="createUser != null  and createUser != ''">`create_user`,</if>
            <if test="createTime != null ">`create_time`,</if>
            <if test="updateUser != null  and updateUser != ''">`update_user`,</if>
            <if test="updateTime != null ">`update_time`,</if>
            <if test="remark != null  and remark != ''">`remark`,</if>
            <if test="tenantKey != null  and tenantKey != ''">`tenant_key`,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="warnId != null ">#{warnId},</if>
            <if test="warnItem != null  and warnItem != ''">#{warnItem},</if>
            <if test="warnItemId != null  and warnItemId != ''">#{warnItemId},</if>
            <if test="warnUserId != null  and warnUserId != ''">#{warnUserId},</if>
            <if test="warnUserName != null  and warnUserName != ''">#{warnUserName},</if>
            <if test="warnContent != null  and warnContent != ''">#{warnContent},</if>
            <if test="warnStatus != null  and warnStatus != ''">#{warnStatus},</if>
            <if test="warnType != null  and warnType != ''">#{warnType},</if>
            <if test="warnUrl != null  and warnUrl != ''">#{warnUrl},</if>
            <if test="createUser != null  and createUser != ''">#{createUser},</if>
            <if test="createTime != null ">#{createTime},</if>
            <if test="updateUser != null  and updateUser != ''">#{updateUser},</if>
            <if test="updateTime != null ">#{updateTime},</if>
            <if test="remark != null  and remark != ''">#{remark},</if>
            <if test="tenantKey != null  and tenantKey != ''">#{tenantKey},</if>
        </trim>
    </insert>

    <!-- 有默认值的情况下 会有问题，建议遍历插入，调用insertTWarn -->
    <insert id="insertTWarnList">
        insert into t_warn
        <trim prefix="(" suffix=")" suffixOverrides=",">
            `warn_id`,
            `warn_item`,
            `warn_item_id`,
            `warn_user_id`,
            `warn_user_name`,
            `warn_content`,
            `warn_status`,
            `warn_type`,
            `warn_url`,
            `create_user`,
            `create_time`,
            `update_user`,
            `update_time`,
            `remark`,
            `tenant_key`,
        </trim>
        values
        <foreach collection="tWarnList" item="item" separator=",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{item.warnId},
                #{item.warnItem},
                #{item.warnItemId},
                #{item.warnUserId},
                #{item.warnUserName},
                #{item.warnContent},
                #{item.warnStatus},
                #{item.warnType},
                #{item.warnUrl},
                #{item.createUser},
