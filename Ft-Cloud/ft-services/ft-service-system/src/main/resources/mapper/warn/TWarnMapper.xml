<mapper namespace="com.hhwy.system.warn.mapper.TWarnMapper">

    <resultMap type="com.hhwy.system.warn.domain.TWarn" id="TWarnResultMap">
        <result property="warnId" column="warn_id"/>
        <result property="warnItem" column="warn_item"/>
        <result property="warnItemId" column="warn_item_id"/>
        <result property="warnUserId" column="warn_user_id"/>
        <result property="warnUserName" column="warn_user_name"/>
        <result property="warnContent" column="warn_content"/>
        <result property="warnStatus" column="warn_status"/>
        <result property="warnType" column="warn_type"/>
        <result property="warnUrl" column="warn_url"/>
        <result property="createUser" column="create_user"/>
        <result property="createTime" column="create_time"/>
        <result property="updateUser" column="update_user"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="tenantKey" column="tenant_key"/>
    </resultMap>
    <sql id="selectTWarnVo">
        select `warn_id`
             , `warn_item`
             , `warn_item_id`
             , `warn_user_id`
             , `warn_user_name`
             , `warn_content`
             , `warn_status`
             , `warn_type`
             , `warn_url`
             , `create_user`
             , `create_time`
             , `update_user`
             , `update_time`
             , `remark`
             , `tenant_key`
        from t_warn
    </sql>
    <select id="getTWarn" resultMap="TWarnResultMap">
        <include refid="selectTWarnVo"/>
        <where>
            del_flag = "0"
            <if test="warnId != null ">and `warn_id` = #{warnId}</if>
            <if test="warnItem != null  and warnItem != ''">and `warn_item` = #{warnItem}</if>
            <if test="warnItemId != null  and warnItemId != ''">and `warn_item_id` = #{warnItemId}</if>
            <if test="warnUserId != null  and warnUserId != ''">and `warn_user_id` = #{warnUserId}</if>
            <if test="warnUserName != null  and warnUserName != ''">and `warn_user_name` = #{warnUserName}</if>
            <if test="warnContent != null  and warnContent != ''">and `warn_content` = #{warnContent}</if>
            <if test="warnStatus != null  and warnStatus != ''">and `warn_status` = #{warnStatus}</if>
            <if test="warnType != null  and warnType != ''">and `warn_type` = #{warnType}</if>
            <if test="warnUrl != null  and warnUrl != ''">and `warn_url` = #{warnUrl}</if>
            <if test="createUser != null  and createUser != ''">and `create_user` = #{createUser}</if>
            <if test="createTime != null ">and `create_time` = #{createTime}</if>
            <if test="updateUser != null  and updateUser != ''">and `update_user` = #{updateUser}</if>
            <if test="updateTime != null ">and `update_time` = #{updateTime}</if>
            <if test="remark != null  and remark != ''">and `remark` = #{remark}</if>
            <if test="tenantKey != null  and tenantKey != ''">and `tenant_key` = #{tenantKey}</if>
        </where>
        order by create_time desc
    </select>

    <select id="getTWarnList" resultMap="TWarnResultMap">
        <include refid="selectTWarnVo"/>
        <where>
