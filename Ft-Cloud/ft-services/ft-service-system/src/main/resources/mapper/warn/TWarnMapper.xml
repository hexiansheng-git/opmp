                #{item.updateTime},
                #{item.remark},
                #{item.tenantKey},
            </trim>
        </foreach>
    </insert>

    <update id="updateTWarn">
        update t_warn
        <trim prefix="SET" suffixOverrides=",">
            <if test="warnId != null ">`warn_id` = #{warnId},</if>
            <if test="warnItem != null  and  warnItem != ''">`warn_item` = #{warnItem},</if>
            <if test="warnItemId != null  and  warnItemId != ''">`warn_item_id` = #{warnItemId},</if>
            <if test="warnUserId != null  and  warnUserId != ''">`warn_user_id` = #{warnUserId},</if>
            <if test="warnUserName != null  and  warnUserName != ''">`warn_user_name` = #{warnUserName},</if>
