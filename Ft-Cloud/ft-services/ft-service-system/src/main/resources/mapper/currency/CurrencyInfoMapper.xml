            <if test="ptVar3 != null">`pt_var3`,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="currencyName != null">#{currencyName},</if>
            <if test="currencyCode != null">#{currencyCode},</if>
            <if test="sort != null">#{sort},</if>
            <if test="createUser != null">#{createUser},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateUser != null">#{updateUser},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delUser != null">#{delUser},</if>
            <if test="delTime != null">#{delTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
            <if test="ptVar1 != null">#{ptVar1},</if>
            <if test="ptVar2 != null">#{ptVar2},</if>
            <if test="ptVar3 != null">#{ptVar3},</if>
         </trim>
    </insert>

    <insert id="batchInsert" parameterType="list">
        insert `t_currency_info` (
                                                `id`,
                                                                `currency_name`,
                                                                `currency_code`,
                                                                `sort`,
                                                                `create_user`,
                                                                `create_time`,
                                                                `update_user`,
