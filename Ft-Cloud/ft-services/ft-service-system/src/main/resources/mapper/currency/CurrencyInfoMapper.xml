    <update id="deleteCurrencyInfoByIds" parameterType="String">
        update `t_currency_info` set del_flag = 1 where `id` in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="validRepeat" parameterType="com.hhwy.domain.base.system.currency.CurrencyInfo" resultMap="CurrencyInfoResult">
        select * from t_currency_info
        <where>
         del_flag='0' and currency_code=#{currencyCode}
         <if test="id!=null"> and id <![CDATA[!= ]]> #{id} </if>
        </where>

    </select>

