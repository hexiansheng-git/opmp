    <update id="updateCurrencyInfo" parameterType="com.hhwy.domain.base.system.currency.CurrencyInfo">
        update `t_currency_info`
        <trim prefix="SET" suffixOverrides=",">
            <if test="currencyName != null">`currency_name` = #{currencyName},</if>
            <if test="currencyCode != null">`currency_code` = #{currencyCode},</if>
            <if test="sort != null">`sort` = #{sort},</if>
            <if test="createUser != null">`create_user` = #{createUser},</if>
            <if test="createTime != null">`create_time` = #{createTime},</if>
            <if test="updateUser != null">`update_user` = #{updateUser},</if>
