<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hhwy.system.currency.mapper.CurrencyInfoMapper">
    <resultMap type="com.hhwy.domain.base.system.currency.CurrencyInfo" id="CurrencyInfoResult">
        <result property="id"    column="id"    />
        <result property="currencyName"    column="currency_name"    />
        <result property="currencyCode"    column="currency_code"    />
        <result property="sort"    column="sort"    />
        <result property="createUser"    column="create_user"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateUser"    column="update_user"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delUser"    column="del_user"    />
        <result property="delTime"    column="del_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
        <result property="ptVar1"    column="pt_var1"    />
        <result property="ptVar2"    column="pt_var2"    />
        <result property="ptVar3"    column="pt_var3"    />
    </resultMap>

    <sql id="selectCurrencyInfoVo">
        select `id`, `currency_name`, `currency_code`, `sort`, `create_user`, `create_time`, `update_user`, `update_time`, `del_user`, `del_time`, `del_flag`, `remark`, `pt_var1`, `pt_var2`, `pt_var3` from `t_currency_info`
    </sql>

    <select id="selectCurrencyInfoList" parameterType="com.hhwy.domain.base.system.currency.CurrencyInfo" resultMap="CurrencyInfoResult">
        <include refid="selectCurrencyInfoVo"/>
        <where>
            `del_flag` = 0
            <if test="currencyName != null  and currencyName != ''"> and `currency_name` like concat('%', #{currencyName}, '%')</if>
            <if test="currencyCode != null  and currencyCode != ''"> and `currency_code` = #{currencyCode}</if>
            <if test="sort != null "> and `sort` = #{sort}</if>
            <if test="createUser != null  and createUser != ''"> and `create_user` = #{createUser}</if>
            <if test="updateUser != null  and updateUser != ''"> and `update_user` = #{updateUser}</if>
            <if test="delUser != null  and delUser != ''"> and `del_user` = #{delUser}</if>
            <if test="delTime != null "> and `del_time` = #{delTime}</if>
            <if test="ptVar1 != null  and ptVar1 != ''"> and `pt_var1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''"> and `pt_var2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''"> and `pt_var3` = #{ptVar3}</if>
            <if test="params.currencyCodes != null and params.currencyCodes != '' ">
                and currency_code in
                <foreach item="item" collection="params.currencyCodes.split(',')" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="params!=null and params.currencyNames != null and params.currencyNames != '' ">
                and currency_name in
                <foreach item="item" collection="params.currencyNames.split(',')" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
        order by `id` desc
    </select>
    
    <select id="selectCurrencyInfoById" parameterType="Long" resultMap="CurrencyInfoResult">
        <include refid="selectCurrencyInfoVo"/>
        where `id` = #{id}
    </select>
    <insert id="insertCurrencyInfo" parameterType="com.hhwy.domain.base.system.currency.CurrencyInfo">
        insert into `t_currency_info`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">`id`,</if>
            <if test="currencyName != null">`currency_name`,</if>
            <if test="currencyCode != null">`currency_code`,</if>
            <if test="sort != null">`sort`,</if>
            <if test="createUser != null">`create_user`,</if>
            <if test="createTime != null">`create_time`,</if>
            <if test="updateUser != null">`update_user`,</if>
            <if test="updateTime != null">`update_time`,</if>
