                                                                `del_time`,
                                                                `remark`,
                                                                `pt_var1`,
                                                                `pt_var2`,
                                                                `pt_var3`
                                    )values
        <foreach collection="dataList" separator="," item="item" index="index" >(
                                        #{item.id},
                                        #{item.currencyName},
                                        #{item.currencyCode},
                                        #{item.sort},
                                        #{item.createUser},
