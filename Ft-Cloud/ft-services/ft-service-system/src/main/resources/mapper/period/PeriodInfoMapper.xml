    <sql id="selectPeriodInfoVo">
        select `id`, `begin_date`, `end_date`, `period_code`, `create_user`, `create_time`, `update_user`, `update_time`, `del_user`, `del_time`, `del_flag`, `remark`, `pt_var1`, `pt_var2`, `pt_var3` from `t_period_info`
    </sql>

    <select id="selectPeriodInfoList" parameterType="com.hhwy.domain.base.system.period.PeriodInfo" resultMap="PeriodInfoResult">
        <include refid="selectPeriodInfoVo"/>
        <where>
            `del_flag` = 0
            <if test="beginDate != null "> and `begin_date` = #{beginDate}</if>
            <if test="endDate != null "> and `end_date` = #{endDate}</if>
            <if test="periodCode != null  and periodCode != ''"> and `period_code` = #{periodCode}</if>
            <if test="createUser != null  and createUser != ''"> and `create_user` = #{createUser}</if>
            <if test="updateUser != null  and updateUser != ''"> and `update_user` = #{updateUser}</if>
            <if test="delUser != null  and delUser != ''"> and `del_user` = #{delUser}</if>
            <if test="delTime != null "> and `del_time` = #{delTime}</if>
            <if test="ptVar1 != null  and ptVar1 != ''"> and `pt_var1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''"> and `pt_var2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''"> and `pt_var3` = #{ptVar3}</if>
            <if test="ids!=null">
                and id in
                <foreach item="id" collection="ids" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="queryDate!=null and queryDate!=''"> and #{queryDate} &gt;= begin_date</if>
            <if test="queryDate!=null and queryDate!=''"> and #{queryDate} &lt;= end_date</if>
        </where>
        order by `create_time` desc
    </select>
    
    <select id="selectPeriodInfoById" parameterType="Long" resultMap="PeriodInfoResult">
        <include refid="selectPeriodInfoVo"/>
        where `id` = #{id}
    </select>
