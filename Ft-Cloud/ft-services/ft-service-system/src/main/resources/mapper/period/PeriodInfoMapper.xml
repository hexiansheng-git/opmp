        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="selectPeriodByDate" parameterType="com.hhwy.domain.base.system.period.PeriodInfo" resultMap="PeriodInfoResult2">
        SELECT
            tci.id,tci.currency_name currencyName,
            tci.currency_code currencyCode,
            a.period_code periodCode,
            a.rate
        FROM
            t_currency_info tci
        INNER JOIN   (
            SELECT
                tc.currency_id,
                tp.period_code,
                tc.rate
            FROM
                t_period_info tp
            LEFT JOIN
                t_period_currency tc
            ON
                tp.period_code = tc.period_code
            WHERE
                 tp.del_flag='0'
            AND
                tc.del_flag='0'
            AND
                DATE_FORMAT(#{periodDate},'%Y-%m-%d') &gt;= tp.begin_date
            AND
                DATE_FORMAT(#{periodDate},'%Y-%m-%d') &lt;= tp.end_date

        ) a on a.currency_id= tci.id  WHERE tci.del_flag='0'
    </select>


    <select id="selectPeriodByMonth" parameterType="com.hhwy.domain.base.system.period.PeriodInfo" resultMap="PeriodInfoResult2">
        SELECT
            tci.id,tci.currency_name currencyName,
            tci.currency_code currencyCode,
            a.period_code periodCode,
            a.rate
        FROM
            t_currency_info tci
        INNER JOIN   (
            SELECT
                tc.currency_id,
                tp.period_code,
                tc.rate
            FROM
                t_period_info tp
            LEFT JOIN
                t_period_currency tc
            ON
                tp.period_code = tc.period_code
            <where>
                tp.del_flag='0' and tc.del_flag='0'
                <if test="null!=periodDate and ''!=periodDate">and #{periodDate}= DATE_FORMAT(tp.begin_date,'%Y-%m')</if>
            </where>

        ) a on a.currency_id= tci.id WHERE tci.del_flag='0'
    </select>



    <select id="validRepeat" parameterType="com.hhwy.domain.base.system.period.PeriodInfo" resultMap="PeriodInfoResult">
        select * from t_period_info
        <where>
            del_flag='0'
            and period_code=#{periodCode}
            <if test="id!=null">and id <![CDATA[!= ]]> #{id}</if>
        </where>
    </select>

    <select id="selectLastMonth" resultType="com.hhwy.domain.base.system.period.PeriodInfo">
        SELECT max(end_date) as endDate from t_period_info WHERE del_flag='0';
    </select>
    <select id="selectPeriodInfoByDate" parameterType="com.hhwy.domain.base.system.period.PeriodInfo" resultMap="PeriodInfoResult">

        select `id`,
               `begin_date`,
               `end_date`,
               `period_code`,
               `create_user`,
               `create_time`,
               `update_user`,
               `update_time`,
               `del_user`,
               `del_time`,
               `del_flag`,
               `remark`,
               `pt_var1`,
               `pt_var2`,
               `pt_var3`
        FROM
        t_period_info  as p
        WHERE
        p.del_flag = '0'
        <if test="periodDate!=null">
            AND p.begin_date  &lt;= DATE_FORMAT(#{periodDate},'%Y-%m-%d')
            AND p.end_date >= DATE_FORMAT(#{periodDate},'%Y-%m-%d')
        </if>
        <if test="periodCode != null and periodCode != ''">
            AND p.period_code = #{periodCode}
        </if>
        limit 1
    </select>

    <select id="selectPeriodByYear" parameterType="com.hhwy.domain.base.system.period.PeriodInfo" resultMap="com.hhwy.system.periodCurrency.mapper.PeriodCurrencyMapper.PeriodCurrencyResult">
        SELECT
            tci.id,
            tpc.rate,
            tci.currency_code,
            tci.currency_name,
            tpc.period_id,
            tpc.period_code
        FROM
            t_currency_info tci
        RIGHT JOIN t_period_currency tpc ON tpc.currency_id = tci.id
        WHERE
            tci.currency_code = #{currencyCode} and tpc.del_flag='0'
          and tci.del_flag='0'
        AND tpc.period_id in(
            SELECT id FROM t_period_info WHERE period_code like concat (#{queryDate},'%') and del_flag='0'
        )
    </select>

    <select id="selectBathByDate" parameterType="list" resultMap="PeriodInfoResult">
        select * from t_period_info WHERE del_flag='0'  and (
         <foreach collection="list" item="item" open="(" close=")" separator="or">#{item} &gt;=begin_date and #{item }
             &lt;=end_date
         </foreach>
         )
        order by create_time desc
    </select>
</mapper>