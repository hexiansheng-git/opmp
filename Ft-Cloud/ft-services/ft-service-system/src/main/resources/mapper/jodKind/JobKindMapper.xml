                                when `id` = #{item.id} then #{item.ptVar3}
                            </if>
                        </foreach>
                    </trim>
                                    </trim>
        where
        <foreach collection="dataList" separator="or" item="item" index="index" >
            `id` = #{item.id}
        </foreach>
    </update>




    <update id="updateJobKind" parameterType="com.hhwy.domain.base.system.jobKind.JobKind">
        update `t_job_kind`
        <trim prefix="SET" suffixOverrides=",">
            <if test="jobName != null">`job_name` = #{jobName},</if>
            <if test="jobCode != null">`job_code` = #{jobCode},</if>
            <if test="sort != null">`sort` = #{sort},</if>
            <if test="createUser != null">`create_user` = #{createUser},</if>
            <if test="createTime != null">`create_time` = #{createTime},</if>
            <if test="updateUser != null">`update_user` = #{updateUser},</if>
            <if test="updateTime != null">`update_time` = #{updateTime},</if>
            <if test="delUser != null">`del_user` = #{delUser},</if>
