    <update id="deleteJobKindById" parameterType="Long">
        update `t_job_kind` set del_flag = 1 where `id` = #{id}
    </update>

    <update id="deleteAll" parameterType="Long">
        update `t_job_kind` set del_flag = 1 WHERE 1 = 1
    </update>

    <update id="deleteJobKindByIds" parameterType="String">
        update `t_job_kind` set del_flag = 1 where `id` in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="validRepeat" parameterType="com.hhwy.domain.base.system.jobKind.JobKind" resultMap="JobKindResult">
        select * from t_job_kind
        <where>
         del_flag='0' and job_code=#{jobCode}
         <if test="id!=null"> and id <![CDATA[!= ]]> #{id} </if>
        </where>

    </select>

    <select id="selectMaxSort" resultType="integer">
        select MAX(sort) as sort from t_job_kind;
