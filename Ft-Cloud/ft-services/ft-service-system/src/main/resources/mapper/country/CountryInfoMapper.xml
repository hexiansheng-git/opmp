    </update>

    <update id="deleteCountryInfoById" parameterType="Long">
        update `t_country_info`
        set del_flag = 1
        where `id` = #{id}
    </update>

    <update id="deleteCountryInfoByIds" parameterType="String">
        update `t_country_info` set del_flag = 1 where `id` in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>


