<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hhwy.system.country.mapper.CountryInfoMapper">
    <resultMap type="com.hhwy.domain.base.system.country.CountryInfo" id="CountryInfoResult">
        <result property="id" column="id"/>
        <result property="countryName" column="country_name"/>
        <result property="countryEnName" column="country_en_name"/>
        <result property="countryCode" column="country_code"/>
        <result property="areaType" column="area_type"/>
        <result property="createUser" column="create_user"/>
        <result property="createTime" column="create_time"/>
        <result property="updateUser" column="update_user"/>
        <result property="updateTime" column="update_time"/>
        <result property="delUser" column="del_user"/>
        <result property="delTime" column="del_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
        <result property="ptVar1" column="pt_var1"/>
        <result property="ptVar2" column="pt_var2"/>
        <result property="ptVar3" column="pt_var3"/>
    </resultMap>

    <sql id="selectCountryInfoVo">
        select `id`,
               `country_name`,
               `country_en_name`,
               `country_code`,
               `area_type`,
               `create_user`,
               `create_time`,
               `update_user`,
               `update_time`,
               `del_user`,
               `del_time`,
               `del_flag`,
               `remark`,
               `pt_var1`,
               `pt_var2`,
               `pt_var3`
        from `t_country_info`
    </sql>

    <select id="selectCountryInfoList" parameterType="com.hhwy.domain.base.system.country.CountryInfo"
            resultMap="CountryInfoResult">
        <include refid="selectCountryInfoVo"/>
        <where>
            `del_flag` = 0
            <if test="countryName != null  and countryName != ''">and `country_name` like concat('%', #{countryName},
                '%')
            </if>
            <if test="countryEnName != null  and countryEnName != ''">and `country_en_name` like concat('%',
                #{countryEnName}, '%')
            </if>
            <if test="countryCode != null  and countryCode != ''">and `country_code` = #{countryCode}</if>
            <if test="areaType != null  and areaType != ''">and `area_type` = #{areaType}</if>
            <if test="createUser != null  and createUser != ''">and `create_user` = #{createUser}</if>
            <if test="updateUser != null  and updateUser != ''">and `update_user` = #{updateUser}</if>
            <if test="delUser != null  and delUser != ''">and `del_user` = #{delUser}</if>
            <if test="delTime != null ">and `del_time` = #{delTime}</if>
            <if test="ptVar1 != null  and ptVar1 != ''">and `pt_var1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''">and `pt_var2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''">and `pt_var3` = #{ptVar3}</if>
        </where>
        order by `id` desc
    </select>

    <select id="selectCountryInfoById" parameterType="Long" resultMap="CountryInfoResult">
        <include refid="selectCountryInfoVo"/>
        where `id` = #{id}
    </select>
    <select id="selectCountryInfoByName" parameterType="String" resultMap="CountryInfoResult">
        <include refid="selectCountryInfoVo"/>
        where `country_name` = #{countryName}
    </select>
    <insert id="insertCountryInfo" parameterType="com.hhwy.domain.base.system.country.CountryInfo">
        insert into `t_country_info`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">`id`,</if>
            <if test="countryName != null">`country_name`,</if>
            <if test="countryEnName != null">`country_en_name`,</if>
            <if test="countryCode != null">`country_code`,</if>
            <if test="areaType != null">`area_type`,</if>
            <if test="createUser != null">`create_user`,</if>
            <if test="createTime != null">`create_time`,</if>
            <if test="updateUser != null">`update_user`,</if>
            <if test="updateTime != null">`update_time`,</if>
            <if test="delUser != null">`del_user`,</if>
            <if test="delTime != null">`del_time`,</if>
            <if test="delFlag != null">`del_flag`,</if>
            <if test="remark != null">`remark`,</if>
            <if test="ptVar1 != null">`pt_var1`,</if>
            <if test="ptVar2 != null">`pt_var2`,</if>
            <if test="ptVar3 != null">`pt_var3`,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="countryName != null">#{countryName},</if>
            <if test="countryEnName != null">#{countryEnName},</if>
            <if test="countryCode != null">#{countryCode},</if>
            <if test="areaType != null">#{areaType},</if>
            <if test="createUser != null">#{createUser},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateUser != null">#{updateUser},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delUser != null">#{delUser},</if>
            <if test="delTime != null">#{delTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
            <if test="ptVar1 != null">#{ptVar1},</if>
            <if test="ptVar2 != null">#{ptVar2},</if>
            <if test="ptVar3 != null">#{ptVar3},</if>
        </trim>
    </insert>

    <insert id="batchInsert" parameterType="list">
        insert `t_country_info` (
        `id`,
        `country_name`,
        `country_en_name`,
        `country_code`,
        `area_type`,
        `create_user`,
        `create_time`,
        `update_user`,
        `update_time`,
        `del_user`,
        `del_time`,
        `del_flag`,
        `remark`,
        `pt_var1`,
        `pt_var2`,
        `pt_var3`,
        )values
        <foreach collection="dataList" separator="," item="item" index="index">
            #{item.id}
            #{item.countryName}
            #{item.countryEnName}
            #{item.countryCode}
            #{item.areaType}
            #{item.createUser}
            #{item.createTime}
            #{item.updateUser}
            #{item.updateTime}
            #{item.delUser}
            #{item.delTime}
            #{item.delFlag}
            #{item.remark}
            #{item.ptVar1}
            #{item.ptVar2}
            #{item.ptVar3}
        </foreach>
    </insert>

    <update id="batchUpdate" parameterType="list">
        update `t_country_info`
        <trim prefix="set" suffixOverrides=",">
            <trim prefix="country_name =case" suffix="end,">
                <foreach collection="dataList" item="item" index="index">
                    <if test="item.countryName != null ">
                        when `id` = #{item.id} then #{item.countryName}
                    </if>
                </foreach>
            </trim>
            <trim prefix="country_en_name =case" suffix="end,">
