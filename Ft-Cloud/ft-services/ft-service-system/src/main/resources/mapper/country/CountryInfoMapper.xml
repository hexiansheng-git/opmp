                    </if>
                </foreach>
            </trim>
        </trim>
        where
        <foreach collection="dataList" separator="or" item="item" index="index">
            `id` = #{item.id}
        </foreach>
    </update>


    <update id="updateCountryInfo" parameterType="com.hhwy.domain.base.system.country.CountryInfo">
        update `t_country_info`
        <trim prefix="SET" suffixOverrides=",">
            <if test="countryName != null">`country_name` = #{countryName},</if>
            <if test="countryEnName != null">`country_en_name` = #{countryEnName},</if>
            <if test="countryCode != null">`country_code` = #{countryCode},</if>
            <if test="areaType != null">`area_type` = #{areaType},</if>
            <if test="createUser != null">`create_user` = #{createUser},</if>
            <if test="createTime != null">`create_time` = #{createTime},</if>
            <if test="updateUser != null">`update_user` = #{updateUser},</if>
            <if test="updateTime != null">`update_time` = #{updateTime},</if>
            <if test="delUser != null">`del_user` = #{delUser},</if>
