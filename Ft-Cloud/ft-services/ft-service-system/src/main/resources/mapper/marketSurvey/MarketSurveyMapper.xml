    <select id="selectMarketInfo" parameterType="com.hhwy.domain.base.system.marketSurvey.MarketSurvey" resultMap="MarketSurveyResult">
        SELECT
            ts.place,
            ts.survey_date,
            ts.factory,
            ti.material_spec as spec,
            ts.parameter,
            ts.configure,
            ts.market_price,
            ts.analysis,
            ti.material_name as materialName,
            ts.remark,
            ti.material_code,
            ts.file_group_id
        FROM
	        t_market_survey ts
        LEFT JOIN t_material_info ti ON ts.material_code = ti.material_code
        /*LEFT JOIN t_material_category tc ON tc.category_code =left(ti.category_code,6)*/
        <where>
            ti.type='1'
            <if test="materialName!=null and materialName!=''">and ti.material_name like concat('%',#{materialName},'%')</if>
            <if test="materialCode!=null and materialCode!=''">and ti.material_code like concat('%',#{materialCode},'%')</if>
        </where>
    </select>
