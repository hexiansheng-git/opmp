<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hhwy.system.mapper.DeptMapper">

    <resultMap type="com.hhwy.system.api.domain.SysDept" id="SysDeptResult">
        <id     property="deptId"     column="dept_id"     />
        <result property="parentId"   column="parent_id"   />
        <result property="ancestors"  column="ancestors"   />
        <result property="deptName"   column="dept_name"   />
        <result property="orderNum"   column="order_num"   />
        <result property="leader"     column="leader"      />
        <result property="phone"      column="phone"       />
        <result property="email"      column="email"       />
        <result property="status"     column="status"      />
        <result property="childrenStatus" column="children_status" />
        <result property="delFlag"    column="del_flag"    />
        <result property="tenantKey"    column="tenant_key"    />
        <result property="deptType"    column="dept_type"    />
        <result property="parentName" column="parent_name" />
        <result property="createUser"   column="create_user"   />
        <result property="createTime" column="create_time" />
        <result property="updateUser"   column="update_user"   />
        <result property="updateTime" column="update_time" />
        <result property="ptVar1"       column="pt_var_1"       />
        <result property="ptVar2"       column="pt_var_2"       />
        <result property="ptVar3"       column="pt_var_3"       />
        <result property="ptVar4"       column="pt_var_4"       />
        <result property="ptVar5"       column="pt_var_5"       />
    </resultMap>


    <select id="selectRegionInfo" resultType="com.hhwy.domain.base.system.SysTreeUtil">
        SELECT
            dept_id as id,
            parent_id as pid,
            dept_name as  name,
            order_num as orderNum,
            dept_type as deptType
        FROM
            sys_dept
        WHERE
                del_flag = '0'
                AND dept_type = 'region'
           OR FIND_IN_SET(
                dept_id,(
                    SELECT
                        GROUP_CONCAT( ancestors )
                    FROM
                        sys_dept
                    WHERE
                        del_flag = '0'
                      AND dept_type = 'region'
                    GROUP BY
                        dept_type
                )
            )
    </select>

    <select id="selectDeptIdByProjectId" parameterType="String" resultMap="SysDeptResult">
        SELECT
            dept_id ,
            parent_id ,
            dept_name ,
            order_num ,
            dept_type
        FROM
            sys_dept
        WHERE
            del_flag = '0'
            AND dept_type = 'prjInfo'
            AND tenant_key='master'
            AND pt_var_1  = #{projectId}
    </select>

    <select id="selectAllDept"  resultMap="SysDeptResult">
        SELECT
            dept_id ,
            parent_id ,
            dept_name ,
            order_num ,
            dept_type
        FROM
            sys_dept
        WHERE
            del_flag = '0'
          AND dept_id  = #{deptId}
          OR  FIND_IN_SET(#{deptId},ancestors)
          OR  FIND_IN_SET(dept_id,#{ancestors})
    </select>

    <select id="selectPrjInfo"  resultMap="SysDeptResult">
        SELECT
            dept_id ,
            parent_id ,
            dept_name ,
            pt_avr_5 ,
            dept_type
        FROM
            sys_dept
        WHERE
            del_flag = '0'
                AND dept_id  = #{deptId}
                AND (dept_type='prjInfo' or dept_type='region')
           OR  FIND_IN_SET(#{deptId},ancestors)
           OR  FIND_IN_SET(dept_id,#{ancestors})

    </select>
    <select id="getProjectOrgInfo" resultMap="SysDeptResult">
        SELECT
            dept_id ,
            parent_id ,
            dept_name ,
            pt_var_5 ,
            dept_type
        FROM
            sys_dept
        WHERE
            del_flag = '0'
                AND dept_type = "prjInfo"
    </select>
    <select id="selectDeptList" resultMap="SysDeptResult">
        SELECT
            dept_id ,
            parent_id ,
            dept_name ,
            pt_var_5 ,
            dept_type
        FROM
            sys_dept
        WHERE
            del_flag = '0'
            AND tenant_key = #{tenantKey}
            <if test="dept != null and dept.parentId != null">
                and parent_id =  #{dept.parentId}
            </if>
            <if test="dept != null and dept.deptName != null and dept.deptName != '' ">
                and dept_name like concat('%', #{dept.deptName}, '%')
            </if>
    </select>
    <select id="selectDeptListAll" resultMap="SysDeptResult">
        SELECT
            dept_id ,
            parent_id ,
            dept_name ,
            pt_var_5 ,
            dept_type,
            ancestors,phone,email,pt_var_1, pt_var_2, pt_var_3, pt_var_4, pt_var_5
        FROM
        sys_dept
        WHERE
        del_flag = '0'
        AND tenant_key = #{tenantKey}
        <choose>
            <when test="dept != null and dept.parentId != null">
                and parent_id =  #{dept.parentId}
            </when>
            <otherwise> and parent_id is null </otherwise>
        </choose>
        <if test="dept != null and dept.deptName != null and dept.deptName != '' ">
            and dept_name like concat('%', #{dept.deptName}, '%')
        </if>
        <if test="dept != null and dept.params != null and dept.params.deptIds != null ">
            and dept_id in
            <foreach collection="dept.params.deptIds" index="index" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
        </if>
    </select>

    <select id="selectDeptListByDeptName" resultMap="SysDeptResult">
        SELECT
            dept_id ,
            ancestors,
            parent_id 
        FROM
        sys_dept
        WHERE
        del_flag = '0'
        AND tenant_key = #{tenantKey}
        <if test="dept != null and dept.deptId != null">
            and dept_id = #{dept.deptId}
        </if>
        <if test="dept != null and dept.deptName != null and dept.deptName != '' ">
            and dept_name like concat('%', #{dept.deptName}, '%')
        </if>
    </select>



</mapper>