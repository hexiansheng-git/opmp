    <update id="updateEquipmentInfo" parameterType="com.hhwy.domain.base.system.equipment.EquipmentInfo">
        update `t_equipment_info`
        <trim prefix="SET" suffixOverrides=",">
            <if test="equipId != null">`equip_id` = #{equipId},</if>
            <if test="equipCode != null">`equip_code` = #{equipCode},</if>
            <if test="equipName != null">`equip_name` = #{equipName},</if>
            <if test="equipSpec != null">`equip_spec` = #{equipSpec},</if>
            <if test="equipCalssify != null">`equip_calssify` = #{equipCalssify},</if>
            <if test="equipUnit != null">`equip_unit` = #{equipUnit},</if>
            <if test="delFlag != null">`del_flag` = #{delFlag},</if>
            <if test="createUser != null">`create_user` = #{createUser},</if>
            <if test="createTime != null">`create_time` = #{createTime},</if>
            <if test="updateUser != null">`update_user` = #{updateUser},</if>
            <if test="updateTime != null">`update_time` = #{updateTime},</if>
            <if test="tenantKey != null and tenantKey != ''">`tenant_key` = #{tenantKey},</if>
            <if test="ptVar1 != null">`pt_var_1` = #{ptVar1},</if>
            <if test="ptVar2 != null">`pt_var_2` = #{ptVar2},</if>
            <if test="ptVar3 != null">`pt_var_3` = #{ptVar3},</if>
            <if test="ptVar4 != null">`pt_var_4` = #{ptVar4},</if>
            <if test="ptVar5 != null">`pt_var_5` = #{ptVar5},</if>
            <if test="parentId != null">`parent_id` = #{parentId},</if>
            <if test="isUse != null">`is_use` = #{isUse},</if>
        </trim>
        where `id` = #{id}
    </update>

    <update id="deleteEquipmentInfoById" parameterType="Long">
        update `t_equipment_info` set del_flag = 1 where `id` = #{id}
    </update>

    <update id="deleteEquipmentInfoByIds" parameterType="String">
        update `t_equipment_info` set del_flag = 1 where `id` in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="selectInfoByEquipmenInfo" parameterType="list" resultMap="EquipmentInfoResult">
        select * from  t_equipment_info where del_flag='0' and equip_code in
        <foreach collection="equipCodeList" separator="," item="equipCode" open="(" close=")">
            #{equipCode}
        </foreach>
    </select>

    <select id="selectByTypeIds" parameterType="list" resultMap="EquipmentInfoResult">
        select ti.id,tt.parent_id,ti.equip_name as equipName,ti.equip_code as equipCode from t_equipment_info ti left join t_equipment_type tt on ti.parent_id = tt.id
        where ti.del_flag='0' and ti.parent_id in
        <foreach collection="equipTypeIds" separator="," item="typeId" open="(" close=")">
            #{typeId}
        </foreach>
    </select>

    <select id="selectInfoByIds" parameterType="list" resultMap="EquipmentInfoResult">
        select * from t_equipment_info where del_flag='0' and id in
        <foreach collection="equipInfoIds" separator="," item="id" open="(" close=")">
            #{id}
        </foreach>
    </select>
