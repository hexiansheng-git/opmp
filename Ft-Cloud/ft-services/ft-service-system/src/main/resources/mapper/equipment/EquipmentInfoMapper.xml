        <result property="parentName" column="parent_name"></result>
    </resultMap>

    <sql id="selectEquipmentInfoVo">
           select
            info.`id`,
            info.`equip_id`,
            info.`equip_code`,
            info.`equip_name`,
            info.`equip_spec`,
            type.equip_name `equip_calssify`,
            info.`equip_unit`,
            info.`del_flag`,
            info.`create_user`,
            info.`create_time`,
            info.`update_user`,
            info.`update_time`,
            info.`tenant_key`,
            info.`pt_var_1`,
            info.`pt_var_2`,
            info.`pt_var_3`,
            info.`pt_var_4`,
            info.`pt_var_5`,
            info.`parent_id`,
						p.equip_name parent_name,
            info.is_use,
            type. code equipCalssifyCode
            from `t_equipment_info` info
            left join t_equipment_type type on SUBSTRING(info.equip_code,1,2)=type.code
						left join t_equipment_type p on p.id = info.parent_id
    </sql>

    <select id="selectEquipmentInfoList" parameterType="com.hhwy.domain.base.system.equipment.EquipmentInfo" resultMap="EquipmentInfoResult">
        <include refid="selectEquipmentInfoVo"/>
        <where>
            info.`del_flag` = 0
            <if test="equipId != null "> and info.`equip_id` = #{equipId}</if>
            <if test="equipCode != null  and equipCode != ''"> and info.`equip_code` like concat('%', #{equipCode}, '%')</if>
            <if test="equipName != null  and equipName != ''"> and info.`equip_name` like concat('%', #{equipName}, '%')</if>
            <if test="equipSpec != null  and equipSpec != ''"> and info.`equip_spec` like concat('%', #{equipSpec}, '%')</if>
            <if test="equipCalssify != null  and equipCalssify != ''"> and info.`equip_calssify` = #{equipCalssify}</if>
            <if test="equipUnit != null  and equipUnit != ''"> and info.`equip_unit` = #{equipUnit}</if>
            <if test="createUser != null  and createUser != ''"> and info.`create_user` = #{createUser}</if>
            <if test="updateUser != null  and updateUser != ''"> and info.`update_user` = #{updateUser}</if>
            <if test="isUse != null  and isUse != ''"> and info.`is_use` = #{isUse}</if>
            <if test="tenantKey != null  and tenantKey != ''"> and info.`tenant_key` = #{tenantKey}</if>
            <if test="ptVar1 != null  and ptVar1 != ''"> and info.`pt_var_1` = #{ptVar1}</if>
            <if test="ptVar2 != null  and ptVar2 != ''"> and info.`pt_var_2` = #{ptVar2}</if>
            <if test="ptVar3 != null  and ptVar3 != ''"> and info.`pt_var_3` = #{ptVar3}</if>
            <if test="ptVar4 != null  and ptVar4 != ''"> and info.`pt_var_4` = #{ptVar4}</if>
            <if test="ptVar5 != null  and ptVar5 != ''"> and info.`pt_var_5` = #{ptVar5}</if>
            <if test="parentId != null  and parentId != ''"> and info.`parent_id` = #{parentId}</if>
            <!--<if test="null!=ids and ids!=''"> and info.id find_in_set(id,#{ids})</if>-->
            <if test="ids!=null and ids.size()>0">
                and info.id in
                <foreach item="id" collection="ids" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="null!=newEquipCode and newEquipCode!=''"> and info.`equip_code` = #{newEquipCode}</if>
            <if test="params.equipNameList != null  and params.equipNameList.size() > 0">
                and info.equip_name IN
                <foreach item="code" collection="params.equipNameList" open="(" separator="," close=")">
                    #{code}
                </foreach>
            </if>
        </where>
        order by info.`equip_code` asc
    </select>
    
    <select id="selectEquipmentInfoById" parameterType="Long" resultMap="EquipmentInfoResult">
        <include refid="selectEquipmentInfoVo"/>
        where `id` = #{id}
    </select>
