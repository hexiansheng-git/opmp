    <delete id="deleteMaterialCategoryById" parameterType="String">
        update `t_material_category` set del_flag = '1' where `id` = #{id}
    </delete>

    <delete id="deleteMaterialCategoryByIds" parameterType="String">
        update `t_material_category`
        set del_flag='1'
        where `id` in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectCategoryByPcode" parameterType="com.hhwy.domain.base.system.material.MaterialCategory" resultMap="MaterialCategoryResult">
        select * from t_material_category where type=#{type} and status=#{status} and `category_code` like concat(#{categoryCode}, '%') and pcode=#{pcode} and del_flag="0" order by pcode
    </select>

    <select id="selectCount" resultType="int">
        select count(*) from t_material_category where del_flag='0';
    </select>
    <!-- 查询编码库一级分类类型 -->
    <select id="materialFistCategory" parameterType="com.hhwy.domain.base.system.material.MaterialCategory" resultMap="MaterialCategoryResult">
        SELECT * from t_material_category WHERE type=#{type} and pcode='0' and del_flag='0';
    </select>


    <select id="selectInfoByCategoryCodes" parameterType="list" resultMap="MaterialCategoryResult">
        select * from t_material_category where category_code in
        <foreach collection="categoryCodeList" item="code" open="(" separator="," close=")">
            #{code}
        </foreach>
    </select>

    <update id="batchUpdate" parameterType="list">
        update t_material_category
        <trim prefix="set" suffixOverrides=",">
            <trim prefix="pid =case" suffix="end,">
                <foreach collection="dataList" item="item" index="index">
                    <if test="item.pid != null ">
                        when `id` = #{item.id} then #{item.pid}
                    </if>
                </foreach>
            </trim>
            <trim prefix="pcode =case" suffix="end,">
                <foreach collection="dataList" item="item" index="index">
                    <if test="item.pcode != null ">
                        when `id` = #{item.id} then #{item.pcode}
                    </if>
                </foreach>
            </trim>
            <trim prefix="category_code =case" suffix="end,">
                <foreach collection="dataList" item="item" index="index">
                    <if test="item.categoryCode != null ">
