         </trim>
    </insert>

    <insert id="batchInsert" parameterType="list">
        insert `t_material_category` (
                    `id`,
                    `pid`,
                    `pcode`,
                    `category_code`,
                    `category_name`,
                    `alias`,
                    `level`,
                    `sort`,
                    `status`,
                    `create_user`,
                    `create_time`,
                    `update_user`,
                    `update_time`,
                    `del_user`,
                    `del_time`,
                    `remark`,
                    `pt_var1`,
                    `pt_var2`,
                    `pt_var3`,
                    `type`
        )values
        <foreach collection="dataList" separator="," item="item" index="index" >
                    (#{item.id},
                    #{item.pid},#{item.pcode},
                    #{item.categoryCode},
                    #{item.categoryName},
                    #{item.alias},
                    #{item.level},
                    #{item.sort},
                    #{item.status},
                    #{item.createUser},
                    #{item.createTime},
                    #{item.updateUser},
                    #{item.updateTime},
                    #{item.delUser},
                    #{item.delTime},
                    #{item.remark},
                    #{item.ptVar1},
                    #{item.ptVar2},
                    #{item.ptVar3},
                    #{item.type})
        </foreach>
    </insert>

    <update id="updateMaterialCategory" parameterType="com.hhwy.domain.base.system.material.MaterialCategory">
        update `t_material_category`
        <trim prefix="SET" suffixOverrides=",">
            <if test="pid != null">`pid` = #{pid},</if>
            <if test="pcode != null">`pcode` = #{pcode},</if>
            <if test="categoryCode != null">`category_code` = #{categoryCode},</if>
            <if test="categoryName != null">`category_name` = #{categoryName},</if>
            <if test="alias != null">`alias` = #{alias},</if>
            <if test="level != null">`level` = #{level},</if>
