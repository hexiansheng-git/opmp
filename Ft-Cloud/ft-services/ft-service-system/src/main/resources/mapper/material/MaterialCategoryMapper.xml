<mapper namespace="com.hhwy.system.mapper.MaterialCategoryMapper">
    <resultMap type="com.hhwy.domain.base.system.material.MaterialCategory" id="MaterialCategoryResult">
        <result property="id"    column="id"    />
        <result property="pid"    column="pid"    />
        <result property="pcode"    column="pcode"    />
        <result property="categoryCode"    column="category_code"    />
        <result property="categoryName"    column="category_name"    />
        <result property="alias"    column="alias"    />
        <result property="level"    column="level"    />
        <result property="sort"    column="sort"    />
        <result property="status"    column="status"    />
        <result property="createUser"    column="create_user"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateUser"    column="update_user"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delUser"    column="del_user"    />
        <result property="delTime"    column="del_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
        <result property="ptVar1"    column="pt_var1"    />
        <result property="ptVar2"    column="pt_var2"    />
        <result property="ptVar3"    column="pt_var3"    />
        <result property="type" column="type"/>
        <result property="path"    column="path"    />
    </resultMap>

    <sql id="selectMaterialCategoryVo">
        select `id`, `category_code`, `category_name`, `alias`, `level`, `sort`, `status`,
               `create_user`, `create_time`, `update_user`, `update_time`, `del_user`, `del_time`, `del_flag`,`remark`, `pt_var1`,`pt_var2`,`pt_var3`
                ,pid, pcode,`type`,`path`
        from `t_material_category`
    </sql>

    <select id="getPosition" resultType="com.hhwy.domain.base.system.material.MaterialCategoryVo">
        select `id`, `category_code` categoryCode, `category_name` categoryName, `alias`, `level`, `sort`, `status`,`update_time`,
        pid, pcode,type
        from `t_material_category`
        where
            del_flag = 0 and type=#{type}
            and FIND_IN_SET(pid,replace((select path from t_material_category where id=#{categoryId}), '/', ','))
        order by sort asc , update_time asc
    </select>

    <select id="getTree" resultType="com.hhwy.domain.base.system.material.MaterialCategoryVo" parameterType="com.hhwy.domain.base.system.material.MaterialCategoryVo">
        select `id`, `category_code` categoryCode, `category_name` categoryName, `alias`, `level`, `sort`, `status`,`update_time`,
                pid, pcode,type
        from `t_material_category`
        <where>
        del_flag = 0
        and type=#{type}
        <if test="pid != null"> and `pid` = #{pid}</if>
        <if test="categoryCode != null  and categoryCode != ''"> and `category_code` like concat(#{categoryCode}, '%')</if>
        <if test="categoryCode != null  and categoryCode != ''">and `pcode` = #{categoryCode}</if>
        <if test="updateTime != null">and `update_time` &gt;= #{updateTime}</if>
        </where>
        order by sort asc , update_time asc
    </select>

    <select id="selectMaterialCategoryList" parameterType="com.hhwy.domain.base.system.material.MaterialCategory" resultMap="MaterialCategoryResult">
        <include refid="selectMaterialCategoryVo"/>
        <where>
            del_flag='0'
            <if test="pid != null"> and `pid` = #{pid}</if>
            <if test="pcode != null"> and `pcode` = #{pcode}</if>
            <if test="categoryCode != null  and categoryCode != ''"> and `category_code` = #{categoryCode}</if>
            <if test="categoryName != null  and categoryName != ''"> and `category_name` like concat('%', #{categoryName}, '%')</if>
            <if test="alias != null  and alias != ''"> and `alias` = #{alias}</if>
            <if test="status != null  and status != ''"> and `status` = #{status}</if>
            <if test="type != null"> and `type` = #{type}</if>
            <if test="categoryCodes != null">
                and category_code in
                 <foreach collection="categoryCodes" item="item" separator="," open="(" close=")">
                     #{item}
                 </foreach>
            </if>
        </where>
        order by level
    </select>

    <select id="newSelectMaterialCategoryList" parameterType="com.hhwy.domain.base.system.material.MaterialCategory" resultMap="MaterialCategoryResult">
        <include refid="selectMaterialCategoryVo"/>
        <where>
            del_flag='0'
            <if test="pid != null"> and `pid` = #{pid}</if>
            <if test="pcode != null"> and `pcode` = #{pcode}</if>
            <if test="categoryCode != null  and categoryCode != ''"> and `category_code` = #{categoryCode}</if>
            <if test="categoryName != null  and categoryName != ''"> and `category_name` like concat('%', #{categoryName}, '%')</if>
            <if test="alias != null  and alias != ''"> and `alias` = #{alias}</if>
            <if test="status != null  and status != ''"> and `status` = #{status}</if>
            <if test="type != null"> and `type` = #{type}</if>
        </where>
        <if test="pageSize != null">
            limit ${pageNum}, ${pageSize}
        </if>
    </select>
    
    <select id="selectMaterialCategoryById" parameterType="long" resultMap="MaterialCategoryResult">
        <include refid="selectMaterialCategoryVo"/>
        where `id` = #{id}
    </select>
    <insert id="insertMaterialCategory" parameterType="com.hhwy.domain.base.system.material.MaterialCategory">
