        </foreach>
    </update>

    <select id="selectBathByPath" parameterType="list" resultMap="MaterialCategoryResult">
        SELECT
            *
        FROM
            t_material_category
        WHERE
            pcode = '0'
    </select>

    <select id="selectBathByCode" parameterType="list" resultMap="MaterialCategoryResult">
        SELECT
            *
        FROM
            t_material_category
        WHERE del_flag='0' and category_code in
        <foreach collection="list" item="item" open="(" separator="," close=")" index="index">
            #{item}
        </foreach>
    </select>
</mapper>