    <select id="validRepetion" parameterType="com.hhwy.domain.base.system.material.MaterialInfo" resultMap="MaterialInfoResult">
        select * from t_material_info where del_flag='0' and material_name=#{materialName} and material_spec=#{materialSpec}
    </select>

    <select id="newValidRepetion" parameterType="com.hhwy.domain.base.system.material.MaterialInfo" resultMap="MaterialInfoResult">
        select * from t_material_info
        <where>
            del_flag='0'
            <if test="materialSpec !=null and materialSpec !=''"> and material_spec =#{materialSpec}</if>
            <if test="materialName != null  and materialName != ''"> and `material_name`=#{materialName}</if>
            <if test="categoryCode != null  and categoryCode != ''">and `category_code` like concat ('%',#{categoryCode},'%')</if>
            <if test="type!=null and type!=''"> and type=#{type}</if>
            <if test="type==null and type==''"> and type!=2</if>
        </where>
        order by material_code desc
    </select>

    <select id="newSelectMaterialInfoList" parameterType="com.hhwy.domain.base.system.material.MaterialInfo" resultMap="MaterialInfoResult">
        <include refid="selectMaterialCategoryInfo"/>
        <if test="type != null "> and tc.type= #{type} </if>
        <where>
            ti.del_flag='0'
            <if test="categoryCode != null  and categoryCode != ''"> and ti.`category_code` like concat ('%',#{categoryCode},'%')</if>
            <if test="materialCode != null  and materialCode != ''"> and ti.`material_code` like concat ('%',#{materialCode},'%')</if>
            <if test="materialName != null  and materialName != ''"> and ti.`material_name` like concat ('%',#{materialName},'%')</if>
            <if test="status != null  and status != ''"> and ti.`status` = #{status}</if>
            <if test="type != null "> and ti.`type` = #{type}</if>
        </where>
        order by ti.sort
    </select>

