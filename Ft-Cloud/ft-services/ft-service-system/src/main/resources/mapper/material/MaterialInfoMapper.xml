    <select id="selectMaterialInfoList" parameterType="com.hhwy.domain.base.system.material.MaterialInfo" resultMap="MaterialInfoResult">
        <include refid="selectMaterialInfoVo"/>
        <where>
            del_flag='0'
            <if test="categoryCode != null  and categoryCode != ''"> and `category_code` like concat (#{categoryCode}, '%')</if>
            <if test="materialCode != null  and materialCode != ''"> and `material_code` like concat('%',#{materialCode},'%') </if>
