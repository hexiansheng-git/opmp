            <if test="status != null  and status != ''"> and `status` = #{status}</if>
            <if test="type != null "> and `type` = #{type}</if>
            <if test="partNo!=null and partNo !=''"> and `part_no` like concat ('%',#{partNo}, '%')</if>
            <if test="params.codeList != null">
                and material_code IN
                <foreach item="code" collection="params.codeList" open="(" separator="," close=")">
                    #{code}
                </foreach>
            </if>

            <if test="params != null and params.nameList != null">
                and material_name IN
                <foreach item="item" collection="params.nameList" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>

            <if test="params != null and params.specList != null">
                and material_spec IN
                <foreach item="item" collection="params.specList" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>

            <if test="params.types != null and params.types.length > 0">
                and type IN
                <foreach item="code" collection="params.types" open="(" separator="," close=")">
                    #{code}
                </foreach>
            </if>
        </where>
        order by create_time desc
        <if test="isFalg != null and isFalg!=''">
            limit ${pageNum}, ${pageSize}
        </if>
        </select>

