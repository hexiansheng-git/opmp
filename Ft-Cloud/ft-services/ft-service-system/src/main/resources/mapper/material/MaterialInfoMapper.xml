    <sql id="selectMaterialInfoVo">
        select `id`, `category_code`, `unit`, `unit_code`, `alias`, `material_code`,material_type, `material_name`, `material_en_name`, `material_spec`,
               `status`, `type`, `create_user`, `create_time`, `update_user`, `update_time`, `del_user`, `del_time`,`category_id`,
               `del_flag`, `remark`, `pt_var1`,`pt_var2`,`pt_var3` ,`sort`,`own_type`,`own_site`,`part_no` from `t_material_info`
    </sql>

    <sql id="selectMaterialCategoryInfo">
        select ti.`id`, ti.`category_code`, ti.`unit`, ti.`unit_code`, ti.`alias`, ti.`material_code`, ti.`material_name`, ti.`material_en_name`, ti.`material_spec`,
               ti.`status`, ti.`type`, ti.`create_user`, ti.`create_time`, ti.`update_user`, ti.`update_time`, ti.`del_user`, ti.`del_time`,ti.`category_id`,
               ti.`del_flag`, ti.`remark`, ti.`pt_var1`,ti.`pt_var2`,ti.`pt_var3` ,ti.`sort` ,tc.category_name,ti.`own_type`,ti.`own_site`,ti.`part_no` as categoryName  from `t_material_info` ti
               left join t_material_category tc on ti.category_code=tc.category_code
    </sql>

    <select id="getMaterialInfoPage"  parameterType="com.hhwy.domain.base.system.material.MaterialInfo" resultMap="MaterialInfoResult">
        <include refid="selectMaterialInfoVo"/>
        <where>
            del_flag='0'
            <if test="categoryCode != null  and categoryCode != ''"> and `category_code` like concat (#{categoryCode}, '%')</if>
            <if test="materialCode != null  and materialCode != ''"> and `material_code` like concat(#{materialCode},'%') </if>
            <if test="materialName != null  and materialName != ''"> and `material_name` like concat(#{materialName}, '%')</if>
            <if test="materialSpec != null  and materialSpec != ''"> and `material_spec` like concat(#{materialSpec}, '%')</if>
            <if test="status != null  and status != ''"> and `status` = #{status}</if>
            <if test="type != null "> and `type` = #{type}</if>
            <if test="updateTime != null "> and `update_time` &gt;= #{updateTime}</if>
            <if test="params.codeList != null">
                and material_code IN
                <foreach item="code" collection="params.codeList" open="(" separator="," close=")">
                    #{code}
                </foreach>
            </if>
        </where>
        order by create_time desc
        limit ${pageNum}, ${pageSize}
    </select>

